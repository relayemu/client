    "Achievements are waiting to send. Keep playing; Relay will retry.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Achievements are waiting to send. Keep playing; Relay will retry."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des succès sont en attente d’envoi. Continue à jouer, Relay réessaiera."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay logros pendientes de enviar. Sigue jugando; Relay volverá a intentarlo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erfolge müssen noch gesendet werden. Spiel weiter; Relay versucht es erneut."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전송 대기 중인 도전 과제가 있습니다. 계속 플레이하세요. Relay가 다시 시도합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prestaties wachten op verzending. Blijf spelen; Relay probeert het opnieuw."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Prestationer väntar på att skickas. Fortsätt spela så försöker Relay igen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli obiettivi sono in attesa di invio. Continua a giocare: Relay riproverà."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Há conquistas aguardando envio. Continue jogando; o Relay tentará novamente."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay logros pendientes de envío. Sigue jugando; Relay volverá a intentarlo."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Osiągnięcia czekają na wysłanie. Graj dalej — Relay spróbuje ponownie."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Realizările așteaptă să fie trimise. Continuă să joci; Relay va încerca din nou."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実績が送信待ちです。プレイを続けてください。Relayが再試行します。"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Há resultados de conquistas a aguardar envio. Continua a jogar; o Relay tentará novamente."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "成就正在等待傳送。你可以繼續遊玩，Relay 會重試。"
          }
        }
      }
    },
    "Achievements waiting to send will be removed from this device. Achievements already on your RetroAchievements account stay there.": {
      "comment": "Destructive disconnect consequence when no achievement session is active.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Achievements waiting to send will be removed from this device. Achievements already on your RetroAchievements account stay there."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les succès en attente d’envoi seront supprimés de cet appareil. Les succès déjà enregistrés sur ton compte RetroAchievements y resteront."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Los logros pendientes de enviar se eliminarán de este dispositivo. Los que ya estén en tu cuenta de RetroAchievements seguirán allí."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch nicht gesendete Erfolge werden von diesem Gerät entfernt. Erfolge, die bereits in deinem RetroAchievements-Account sind, bleiben dort."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전송 대기 중인 도전 과제가 이 기기에서 삭제됩니다. RetroAchievements 계정에 이미 있는 도전 과제는 그대로 유지됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prestaties die op verzending wachten, worden van dit apparaat verwijderd. Prestaties die al in je RetroAchievements-account staan, blijven daar."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Prestationer som väntar på att skickas tas bort från den här enheten. Prestationer som redan finns på ditt RetroAchievements-konto finns kvar där."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli obiettivi in attesa di invio verranno rimossi da questo dispositivo. Quelli già presenti nel tuo account RetroAchievements resteranno nell’account."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As conquistas aguardando envio serão removidas deste dispositivo. As conquistas que já estão na sua conta do RetroAchievements continuarão lá."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Los logros pendientes de envío se eliminarán de este dispositivo. Los logros que ya estén en tu cuenta de RetroAchievements permanecerán ahí."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Osiągnięcia czekające na wysłanie zostaną usunięte z tego urządzenia. Osiągnięcia znajdujące się już na Twoim koncie RetroAchievements pozostaną na nim."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Realizările care așteaptă să fie trimise vor fi eliminate de pe acest dispozitiv. Cele aflate deja în contul tău RetroAchievements rămân acolo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "送信待ちの実績はこのデバイスから削除されます。RetroAchievementsアカウントに送信済みの実績は残ります。"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os resultados de conquistas a aguardar envio serão removidos deste dispositivo. As conquistas que já estão na tua conta RetroAchievements permanecem lá."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將從此裝置移除等待傳送的成就。已在你的 RetroAchievements 帳號中的成就會保留。"
          }
        }
      }
    },
