    "Mac gameplay and advanced play tools, with Once or Monthly.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Joue sur Mac, remonte plus loin dans ta partie et personnalise tes commandes."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Play on Mac, rewind further and make the controls your own."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Juega en Mac, rebobina durante más tiempo y personaliza los controles."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spiele auf dem Mac, spule weiter zurück und passe die Steuerung an."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac에서 플레이하고, 더 오래 되감고, 원하는 대로 조작을 설정하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Speel op Mac, spoel verder terug en pas de bediening aan."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Spela på Mac, spola längre tillbaka och anpassa reglagen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gioca su Mac, riavvolgi più a lungo e personalizza i controlli."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Jogue no Mac, retroceda por mais tempo e personalize os controles."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Juega en Mac, rebobina más y haz tuyos los controles."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Graj na Macu, przewijaj dalej wstecz i dostosuj sterowanie do siebie."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Joacă pe Mac, derulează mai mult înapoi și personalizează comenzile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macでプレイし、さらに長く巻き戻し、操作を自分好みに設定できます。"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Joga no Mac, retrocede mais e personaliza os comandos."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Mac 上遊玩、倒轉更久，並依喜好自訂控制項。"
          }
        }
      }
    },
