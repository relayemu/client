    "Game-file sync stays off until you turn it on in iCloud settings.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour jouer sur un autre appareil, active « Synchroniser les fichiers de jeu » dans les réglages iCloud."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To play on another device, turn on Sync game files in iCloud settings."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Para jugar en otro dispositivo, activa «Sincronizar archivos de juego» en los ajustes de iCloud."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviere in den iCloud-Einstellungen „Spieldateien synchronisieren“, um auf einem anderen Gerät zu spielen."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 기기에서 플레이하려면 iCloud 설정에서 게임 파일 동기화를 켜세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schakel Gamebestanden synchroniseren in de iCloud-instellingen in om op een ander apparaat te spelen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå på Synka spelfiler i iCloud-inställningarna för att spela på en annan enhet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per giocare su un altro dispositivo, attiva Sincronizza file di gioco nelle impostazioni di iCloud."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para jogar em outro dispositivo, ative Sincronizar arquivos de jogo nos Ajustes do iCloud."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Para jugar en otro dispositivo, activa Sincronizar archivos de juego en la configuración de iCloud."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby grać na innym urządzeniu, włącz opcję „Synchronizuj pliki gier” w ustawieniach iCloud."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pentru a juca pe alt dispozitiv, activează „Sincronizează fișierele jocurilor” în setările iCloud."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別のデバイスでプレイするには、iCloud設定で「ゲームファイルを同期」をオンにしてください。"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Para jogares noutro dispositivo, ativa Sincronizar ficheiros de jogo nas definições do iCloud."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "若要在另一部裝置上遊玩，請在 iCloud 設定中開啟「同步遊戲檔案」。"
          }
        }
      }
    },
