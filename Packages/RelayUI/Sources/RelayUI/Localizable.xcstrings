          "stringUnit": {
            "state": "translated",
            "value": "Ta progression pour %@ est ici. Ajoute le fichier de jeu sur %@ pour continuer à jouer."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu progreso de %@ está aquí. Añade el archivo del juego en %@ para seguir jugando."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Fortschritt für %@ ist hier. Füge die Spieldatei auf %@ hinzu, um weiterzuspielen."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 게임의 진행 상황이 여기에 있습니다. 계속 플레이하려면 %@에 게임 파일을 추가하세요."
