    "That game isn't in your library any more.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce jeu n’est plus dans ta bibliothèque."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Ese juego ya no está en tu biblioteca."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Spiel ist nicht mehr in deiner Mediathek."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "해당 게임이 더 이상 라이브러리에 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
