            "state": "translated",
            "value": "Du spelade på %@ och %@ medan enheterna inte var synkroniserade. Välj vilka framsteg du vill behålla."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai giocato su %@ e %@ mentre non erano sincronizzati. Scegli quale avanzamento mantenere."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você jogou em %@ e %@ enquanto eles estavam fora de sincronia. Escolha qual progresso deseja manter."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Jugaste en %@ y %@ mientras no estaban sincronizados. Elige qué progreso conservar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Grałeś na dwóch urządzeniach — %@ i %@ — gdy nie były zsynchronizowane. Wybierz postępy, które chcesz zachować."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ai jucat pe %@ și %@ cât timp acestea nu erau sincronizate. Alege progresul pe care vrei să-l păstrezi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同期されていない間に%@と%@でプレイしました。残す進行状況を選択してください。"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Jogaste em %@ e %@ enquanto estavam dessincronizados. Escolhe o progresso que queres manter."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你曾在尚未同步的 %@ 和 %@ 上遊玩。請選擇要保留的進度。"
          }
        }
      },
      "comment": "Placeholder 1 `%@` is the generic localized device-kind name for conflict side A; placeholder 2 `%@` is the generic localized device-kind name for conflict side B. These are device categories such as iPhone, iPad, Apple TV, Mac, or “Another device”, never personal device names. This is the body of the two-version save-conflict message; preserve the A-then-B association if reordered."
    },
    "Your Apple purchase is safe. Open Relay account settings to finish membership setup. You don't need to buy again.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton achat est enregistré. Termine l’activation dans « Compte Relay ». Inutile d’acheter à nouveau."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your purchase is saved. Finish setup in Relay Account. You don’t need to buy again."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu compra está guardada. Finaliza la configuración en Cuenta Relay. No necesitas volver a comprar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Kauf ist gespeichert. Schließe die Einrichtung unter „Relay Account“ ab. Du musst nichts erneut kaufen."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구매 내역이 저장되었습니다. Relay Account에서 설정을 완료하세요. 다시 구매할 필요가 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je aankoop is gelukt. Rond het instellen af in de instellingen van je Relay Account. Je hoeft niet opnieuw te kopen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditt köp har sparats. Slutför inställningen under Relay-kontot. Du behöver inte köpa igen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’acquisto è registrato. Completa la configurazione in Relay Account. Non devi acquistare di nuovo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua compra está salva. Conclua a configuração na Relay Account. Você não precisa comprar novamente."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu compra está registrada. Finaliza la configuración en Cuenta Relay. No tienes que comprarla de nuevo."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zakup został zapisany. Dokończ konfigurację w ustawieniach Konta Relay. Nie musisz kupować ponownie."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Achiziția ta a fost înregistrată. Finalizează configurarea în Relay Account. Nu trebuie să cumperi din nou."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "購入情報は保存されています。Relay Accountで設定を完了してください。再購入は不要です。"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A tua compra está guardada. Conclui a configuração na Relay Account. Não precisas de comprar novamente."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的購買紀錄已保留。請在 Relay 帳號中完成設定，無須再次購買。"
          }
        }
      }
    },
    "Your Apple purchase is safe. Relay couldn't finish setting up your membership. Try Finish membership setup when you're back online. You don't need to buy again.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton achat est enregistré. Une fois en ligne, termine l’activation. Inutile d’acheter à nouveau."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your purchase is saved. Finish setup when you’re online. You don’t need to buy again."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu compra está guardada. Finaliza la configuración cuando tengas conexión. No necesitas volver a comprar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Kauf ist gespeichert. Schließe die Einrichtung ab, sobald du online bist. Du musst nichts erneut kaufen."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구매 내역이 저장되었습니다. 온라인 상태에서 설정을 완료하세요. 다시 구매할 필요가 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
