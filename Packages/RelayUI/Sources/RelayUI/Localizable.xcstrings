    },
    "Saves and progress follow you across your devices. Game files in iCloud count against your storage; downloads happen only when you play.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes sauvegardes et ta progression te suivent sur tous tes appareils. Les fichiers de jeu dans iCloud comptent dans ton stockage ; ils ne sont téléchargés que quand tu joues."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus guardados y tu progreso te acompañan en todos tus dispositivos. Los archivos de juego de iCloud ocupan espacio en tu almacenamiento; solo se descargan cuando juegas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speicherstände und Fortschritt sind auf deinen Geräten verfügbar. Spieldateien in iCloud werden auf deinen Speicher angerechnet; sie werden erst beim Spielen heruntergeladen."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세이브와 진행 상황이 모든 기기에서 동기화됩니다. iCloud의 게임 파일은 저장 공간을 사용하며, 다운로드는 플레이할 때만 진행됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opslagpunten en voortgang volgen je op je apparaten. Gamebestanden in iCloud tellen mee voor je opslagruimte; ze worden alleen tijdens het spelen gedownload."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sparningar och framsteg följer med mellan dina enheter. Spelfiler i iCloud räknas mot ditt lagringsutrymme. De hämtas bara när du spelar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I salvataggi e i progressi ti seguono su tutti i tuoi dispositivi. I file di gioco in iCloud vengono conteggiati nel tuo spazio di archiviazione; i download avvengono solo quando giochi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus salvamentos e seu progresso acompanham você nos seus dispositivos. Os arquivos de jogo no iCloud ocupam seu armazenamento; os downloads só acontecem quando você joga."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus guardados y tu progreso te acompañan en todos tus dispositivos. Los archivos de juego en iCloud usan tu espacio de almacenamiento; solo se descargan cuando juegas."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisy i postępy są dostępne na wszystkich Twoich urządzeniach. Pliki gier w iCloud zajmują miejsce; są pobierane dopiero po uruchomieniu gry."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvările și progresul te urmează pe toate dispozitivele. Fișierele jocurilor din iCloud ocupă spațiu din stocarea ta; descărcările au loc numai când joci."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セーブと進行状況はデバイス間で同期されます。iCloud上のゲームファイルはストレージを使用し、ダウンロードはプレイ時にのみ行われます。"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os pontos guardados e o progresso acompanham-te nos teus dispositivos. Os ficheiros de jogo no iCloud ocupam o teu armazenamento; só são descarregados quando jogas."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "存檔和進度會在你的裝置間隨你同行。iCloud 中的遊戲檔案會占用你的儲存空間，且只會在你遊玩時下載。"
          }
        }
      }
    },
    "Saves and progress follow you across your devices. Game files stay where you added them.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes sauvegardes et ta progression te suivent sur tous tes appareils. Les fichiers de jeu restent là où tu les as ajoutés."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus guardados y tu progreso te acompañan en todos tus dispositivos. Los archivos de juego permanecen donde los añadiste."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speicherstände und Fortschritt sind auf deinen Geräten verfügbar. Spieldateien bleiben dort, wo du sie hinzugefügt hast."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세이브와 진행 상황이 모든 기기에서 동기화됩니다. 게임 파일은 추가한 기기에 그대로 남습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opslagpunten en voortgang volgen je op je apparaten. Gamebestanden blijven waar je ze hebt toegevoegd."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sparningar och framsteg följer med mellan dina enheter. Spelfilerna finns kvar där du lade till dem."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I salvataggi e i progressi ti seguono su tutti i tuoi dispositivi. I file di gioco rimangono dove li hai aggiunti."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus salvamentos e seu progresso acompanham você nos seus dispositivos. Os arquivos de jogo permanecem onde você os adicionou."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus guardados y tu progreso te acompañan en todos tus dispositivos. Los archivos de juego permanecen donde los agregaste."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisy i postępy są dostępne na wszystkich Twoich urządzeniach. Pliki gier pozostają tam, gdzie zostały dodane."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvările și progresul te urmează pe toate dispozitivele. Fișierele jocurilor rămân acolo unde le-ai adăugat."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セーブと進行状況はデバイス間で同期されます。ゲームファイルは追加した場所に残ります。"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os pontos guardados e o progresso acompanham-te nos teus dispositivos. Os ficheiros de jogo ficam onde os adicionaste."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "存檔和進度會在你的裝置間隨你同行。遊戲檔案會留在你加入它們的位置。"
          }
        }
      }
    },
