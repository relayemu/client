    "Its file isn't where Relay keeps it any more. Your in-game save is still available.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier est introuvable. Tes sauvegardes du jeu restent inchangées."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file is missing. Your in-game saves are unchanged."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Falta el archivo. Tus guardados del juego no se han modificado."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datei fehlt. Deine spielinternen Speicherstände sind unverändert."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
