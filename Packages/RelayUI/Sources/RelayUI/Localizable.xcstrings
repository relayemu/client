    "Subscriptions renew automatically until cancelled. You can change plans or cancel in the App Store.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton abonnement se renouvelle automatiquement jusqu’à sa résiliation. Tu peux changer de formule ou le résilier dans l’App Store."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Las suscripciones se renuevan automáticamente hasta que las canceles. Puedes cambiar de plan o cancelar en el App Store."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abos verlängern sich automatisch, bis du kündigst. Du kannst im App Store den Tarif wechseln oder kündigen."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구독은 취소할 때까지 자동으로 갱신됩니다. App Store에서 요금제를 변경하거나 구독을 취소할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonnementen worden automatisch verlengd tot je opzegt. Je kunt in de App Store van formule wisselen of je abonnement opzeggen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonnemang förnyas automatiskt tills de sägs upp. Du kan byta plan eller säga upp abonnemanget i App Store."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli abbonamenti si rinnovano automaticamente fino all’annullamento. Puoi modificare i piani o annullare l’abbonamento nell’App Store."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As assinaturas são renovadas automaticamente até o cancelamento. Você pode mudar de plano ou cancelar na App Store."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Las suscripciones se renuevan automáticamente hasta que las canceles. Puedes cambiar de plan o cancelar en App Store."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Subskrypcje odnawiają się automatycznie do czasu anulowania. Plan możesz zmienić lub anulować w App Store."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonamentele se reînnoiesc automat până la anulare. Poți schimba planul sau anula abonamentul în App Store."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サブスクリプションはキャンセルするまで自動更新されます。プランの変更やキャンセルはApp Storeで行えます。"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As subscrições renovam-se automaticamente até serem canceladas. Podes mudar de plano ou cancelar na App Store."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "訂閱會自動續訂，直到取消為止。你可以在 App Store 中更改方案或取消訂閱。"
          }
        }
      }
    },
