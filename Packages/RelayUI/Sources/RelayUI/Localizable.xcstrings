    "Your files have arrived. Relay is checking them and adding games. Large archives can take a few minutes.": {
      "extractionState": "manual",
      "comment": "Relay Transfer guided device screen. Owner-requested UX refinement; translations require rendered owner/editorial review.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your files have arrived. Relay is checking them and adding games. Large archives can take a few minutes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes fichiers sont arrivés. Relay les vérifie et ajoute les jeux. Les grandes archives peuvent prendre quelques minutes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Dateien sind angekommen. Relay prüft sie und fügt Spiele hinzu. Große Archive können einige Minuten dauern."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus archivos han llegado. Relay los está comprobando y añadiendo los juegos. Los archivos comprimidos grandes pueden tardar unos minutos."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus archivos han llegado. Relay los está revisando y agregando los juegos. Los archivos comprimidos grandes pueden tardar unos minutos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi file sono arrivati. Relay li sta verificando e aggiungendo i giochi. Gli archivi grandi possono richiedere qualche minuto."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je bestanden zijn aangekomen. Relay controleert ze en voegt de games toe. Grote archieven kunnen enkele minuten duren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje pliki dotarły. Relay sprawdza je i dodaje gry. Duże archiwa mogą wymagać kilku minut."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os teus ficheiros chegaram. O Relay está a verificá-los e a adicionar os jogos. Os arquivos grandes podem demorar alguns minutos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus arquivos chegaram. O Relay está verificando os arquivos e adicionando os jogos. Arquivos compactados grandes podem levar alguns minutos."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dina filer har kommit fram. Relay kontrollerar dem och lägger till spel. Stora arkiv kan ta några minuter."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fișierele tale au ajuns. Relay le verifică și adaugă jocurile. Arhivele mari pot dura câteva minute."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルを受信しました。Relayが確認してゲームを追加しています。大きなアーカイブは数分かかることがあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일을 받았어요. Relay가 파일을 확인하고 게임을 추가하고 있어요. 큰 압축 파일은 몇 분 정도 걸릴 수 있어요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的檔案已送達。Relay 正在檢查檔案並加入遊戲。大型壓縮檔可能需要幾分鐘。"
          }
        }
      }
    },
