    "Hosted storage for your games and progress. Relay Pro is included while your Sync plan is active.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garde tes jeux et sauvegardes en ligne. Relay Pro est inclus tant que ta formule est active."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep your games and saves online. Includes Relay Pro while your plan is active."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda tus juegos y guardados en línea. Incluye Relay Pro mientras tu plan esté activo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte deine Spiele und Speicherstände online. Relay Pro ist enthalten, solange dein Tarif aktiv ist."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "게임과 세이브를 온라인에 보관하세요. 요금제가 활성화되어 있는 동안 Relay Pro가 포함됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewaar je games en opslagpunten online. Inclusief Relay Pro zolang je formule actief is."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha dina spel och sparningar lagrade online. Relay Pro ingår medan din plan är aktiv."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantieni i tuoi giochi e i tuoi salvataggi online. Include Relay Pro mentre il tuo piano è attivo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha seus jogos e salvamentos online. Inclui o Relay Pro enquanto seu plano estiver ativo."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén tus juegos y guardados en línea. Relay Pro está incluido mientras tu plan esté activo."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przechowuj gry i zapisy online. Plan obejmuje Relay Pro, dopóki jest aktywny."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Păstrează-ți jocurile și salvările online. Relay Pro este inclus cât timp planul tău este activ."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゲームとセーブをオンラインに保存します。プランが有効な間はRelay Proも含まれます。"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantém os teus jogos e pontos guardados online. Inclui o Relay Pro enquanto o teu plano estiver ativo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讓遊戲和存檔保留在線上。方案有效期間包含 Relay Pro。"
          }
        }
      }
    },
