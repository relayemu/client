          "stringUnit": {
            "state": "translated",
            "value": "Importe outra cópia do arquivo de jogo. Nada em %@ foi alterado."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Importa otra copia del archivo del juego. No se cambió nada en %@."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaimportuj inną kopię pliku gry. Bez zmian w lokalizacji: %@."
