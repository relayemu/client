    "Some older progress belongs to another device and stays local here. Open Relay on the original device to sync it.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some earlier progress couldn’t be synced."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
