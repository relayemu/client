    "Refresh your account status or open your account portal. Your local games and saves stay available.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Refresh your account or manage it online. Your games and saves on this device are still available."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualise ton compte ou gère-le en ligne. Tes jeux et sauvegardes sur cet appareil restent disponibles."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualiza tu Cuenta Relay o gestiónala en línea. Tus juegos y guardados siguen disponibles en este dispositivo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktualisiere deinen Account oder verwalte ihn online. Deine Spiele und Speicherstände auf diesem Gerät sind weiter verfügbar."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정을 새로 고치거나 온라인에서 관리하세요. 이 기기의 게임과 세이브는 계속 이용할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vernieuw je accountstatus of beheer je account online. Je games en opslagpunten op dit apparaat blijven beschikbaar."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Uppdatera ditt konto eller hantera det online. Spelen och sparningarna på den här enheten är fortfarande tillgängliga."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiorna il tuo account o gestiscilo online. I tuoi giochi e i salvataggi su questo dispositivo sono ancora disponibili."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Atualize sua conta ou gerencie-a online. Seus jogos e salvamentos neste dispositivo continuam disponíveis."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualiza tu Cuenta Relay o adminístrala en línea. Tus juegos y guardados en este dispositivo siguen disponibles."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odśwież konto lub zarządzaj nim online. Gry i zapisy na tym urządzeniu są nadal dostępne."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualizează-ți contul sau gestionează-l online. Jocurile și salvările tale de pe acest dispozitiv sunt încă disponibile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウント情報を更新するか、オンラインで管理してください。このデバイスのゲームとセーブは引き続き利用できます。"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Atualiza a tua conta ou gere-a online. Os teus jogos e pontos guardados neste dispositivo continuam disponíveis."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重新整理帳號狀態，或在線上管理帳號。這部裝置上的遊戲和存檔仍可使用。"
          }
        }
      }
    },
