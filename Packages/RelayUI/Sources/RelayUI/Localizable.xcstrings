          "stringUnit": {
            "state": "translated",
            "value": "Falta el archivo. Tus guardados del juego no cambian."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brakuje pliku. Zapisy w grze pozostają bez zmian."
