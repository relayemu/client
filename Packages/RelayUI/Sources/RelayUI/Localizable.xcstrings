    "Relay plays the game files you own on iPhone, iPad, Apple TV and Mac, and keeps your progress with you.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay lit les fichiers de jeu que tu possèdes sur iPhone, iPad, Apple TV et Mac, et garde ta progression avec toi."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay te permite jugar con los archivos de juego que poseas en iPhone, iPad, Apple TV y Mac, y llevar tu progreso contigo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay spielt deine eigenen Spieldateien auf iPhone, iPad, Apple TV und Mac und hält deinen Fortschritt überall für dich bereit."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay를 사용하면 본인이 소유한 게임 파일을 iPhone, iPad, Apple TV 및 Mac에서 플레이하고 진행 상황을 이어갈 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay speelt je eigen gamebestanden op iPhone, iPad, Apple TV en Mac en houdt je voortgang bij je."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay spelar spelfilerna du äger på iPhone, iPad, Apple TV och Mac och låter dina framsteg följa med."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay ti permette di giocare con i file di gioco che possiedi su iPhone, iPad, Apple TV e Mac e di portare con te i tuoi progressi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Com o Relay, você joga os arquivos de jogo que possui no iPhone, iPad, Apple TV e Mac e leva seu progresso com você."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Con Relay puedes jugar en iPhone, iPad, Apple TV y Mac con tus propios archivos de juego y llevar tu progreso contigo."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay pozwala grać w posiadane gry na iPhonie, iPadzie, Apple TV i Macu oraz zachowuje Twoje postępy na wszystkich tych urządzeniach."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay îți permite să joci pe iPhone, iPad, Apple TV și Mac folosind fișierele de joc pe care le deții și îți păstrează progresul la îndemână."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Relayは所有するゲームファイルをiPhone、iPad、Apple TV、Macでプレイし、進行状況をどのデバイスでも使えるようにします。"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Relay permite-te jogar no iPhone, iPad, Apple TV e Mac com os ficheiros de jogo que possuis e mantém o teu progresso contigo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay 可在 iPhone、iPad、Apple TV 和 Mac 上遊玩你擁有的遊戲檔案，並讓進度隨你同行。"
          }
        }
      }
    },
    "Relay saves as you go. Rewind keeps the last moments in memory only.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay sauvegarde pendant que tu joues. Le retour arrière est disponible pendant la partie en cours."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay saves as you play. Rewind is available during the current session."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay guarda tu progreso mientras juegas. El rebobinado está disponible durante la partida actual."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay speichert während des Spielens. In der aktuellen Sitzung kannst du zurückspulen."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "플레이하는 동안 Relay가 저장합니다. 현재 세션에서는 되감기를 사용할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay slaat op terwijl je speelt. Terugspoelen is alleen beschikbaar tijdens de huidige sessie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay sparar medan du spelar. Tillbakaspolning är tillgänglig under den aktuella sessionen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay salva mentre giochi. Il riavvolgimento è disponibile durante la sessione corrente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Relay salva enquanto você joga. Retroceder fica disponível durante a sessão atual."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay guarda tu progreso mientras juegas. Puedes rebobinar durante la sesión actual."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay zapisuje postępy podczas gry. Przewijanie wstecz jest dostępne w bieżącej sesji."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay salvează în timp ce joci. Derularea înapoi este disponibilă în sesiunea curentă."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プレイ中はRelayが自動で保存します。現在のセッションでは巻き戻しを利用できます。"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Relay guarda à medida que jogas. A função de retrocesso está disponível durante a sessão atual."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay 會在你遊玩時儲存。你可以在這次遊玩中倒轉。"
          }
        }
      }
    },
    "Relay saves as you go. With iCloud on, your saves and your library follow you to every Relay. Without iCloud, everything still works right here.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay sauvegarde pendant que tu joues. Active iCloud pour retrouver ta bibliothèque et tes sauvegardes sur tous tes appareils."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay saves as you play. Turn on iCloud to keep your library and saves with you on every device."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay guarda tu progreso mientras juegas. Activa iCloud para tener tu biblioteca y tus guardados en todos tus dispositivos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay speichert während des Spielens. Aktiviere iCloud, damit deine Mediathek und Speicherstände auf jedem Gerät verfügbar sind."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "플레이하는 동안 Relay가 저장합니다. 모든 기기에서 라이브러리와 세이브를 이용하려면 iCloud를 켜세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay slaat op terwijl je speelt. Schakel iCloud in om je bibliotheek en opslagpunten op elk apparaat bij je te houden."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay sparar medan du spelar. Slå på iCloud för att ha med biblioteket och sparningarna på alla enheter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay salva mentre giochi. Attiva iCloud per avere libreria e salvataggi su ogni dispositivo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Relay salva enquanto você joga. Ative o iCloud para levar sua biblioteca e seus salvamentos a todos os dispositivos."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay guarda tu progreso mientras juegas. Activa iCloud para tener tu biblioteca y tus guardados en todos tus dispositivos."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay zapisuje postępy podczas gry. Włącz iCloud, aby mieć bibliotekę i zapisy przy sobie na każdym urządzeniu."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay salvează în timp ce joci. Activează iCloud pentru a-ți păstra biblioteca și salvările pe toate dispozitivele."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プレイ中はRelayが自動で保存します。iCloudをオンにすると、すべてのデバイスでライブラリとセーブを利用できます。"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Relay guarda à medida que jogas. Ativa o iCloud para manter a tua biblioteca e os teus pontos guardados em todos os dispositivos."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay 會在你遊玩時儲存。開啟 iCloud，即可讓遊戲庫和存檔在每部裝置上隨你同行。"
          }
        }
      }
    },
