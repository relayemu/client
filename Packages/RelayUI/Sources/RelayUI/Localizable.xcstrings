          "stringUnit": {
            "state": "translated",
            "value": "Usuń wszędzie"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Șterge de peste tot"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての場所から削除"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminar em todo o lado"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從各處刪除"
          }
        }
      }
    },
    "Delete Everywhere removes the game and its saves from iCloud and all your devices. Saves can't be recovered.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer partout retire le jeu et ses sauvegardes d’iCloud et de tous tes appareils. Les sauvegardes ne pourront pas être récupérées."
          }
        }
      }
    },
    "Delete Everywhere removes the game and its saves from the selected sync service and devices using it. Other services keep their copies. Saves can't be recovered.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete Everywhere removes the game and its saves from the selected sync service and devices using it. Other services keep their copies. This can’t be undone on the selected service."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer partout retire le jeu et ses sauvegardes du service choisi et des appareils qui l’utilisent. Les autres services gardent leurs copies. Cette action est irréversible sur le service choisi."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "«Eliminar en todas partes» elimina el juego y sus guardados del servicio de sincronización seleccionado y de los dispositivos que lo usan. Los demás servicios conservan sus copias. Esta acción no se puede deshacer en el servicio seleccionado."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Überall löschen“ entfernt das Spiel und seine Speicherstände aus dem gewählten Synchronisierungsdienst sowie von allen Geräten, die ihn verwenden. Andere Dienste behalten ihre Kopien. Diese Aktion kann im gewählten Dienst nicht rückgängig gemacht werden."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 곳에서 삭제하면 선택한 동기화 서비스와 이를 사용하는 기기에서 게임과 세이브가 삭제됩니다. 다른 서비스의 사본은 유지됩니다. 선택한 서비스에서는 이 작업을 되돌릴 수 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Met Overal verwijderen verwijder je de game en de opslagpunten uit de gekozen synchronisatieservice en van apparaten die deze gebruiken. Andere services behouden hun kopieën. Dit kan niet ongedaan worden gemaakt in de gekozen service."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Radera överallt tar bort spelet och dess sparningar från den valda synkroniseringstjänsten och enheter som använder den. Andra tjänster behåller sina kopior. Det här går inte att ångra i den valda tjänsten."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina ovunque rimuove il gioco e i relativi salvataggi dal servizio di sincronizzazione selezionato e dai dispositivi che lo utilizzano. Altri servizi conservano le loro copie. Questa azione non può essere annullata sul servizio selezionato."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apagar em todos os lugares remove o jogo e seus salvamentos do serviço de sincronização selecionado e dos dispositivos que o usam. Outros serviços mantêm suas cópias. Esta ação não pode ser desfeita no serviço selecionado."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminar en todas partes elimina el juego y sus guardados del servicio de sincronización seleccionado y de los dispositivos que lo usan. Los demás servicios conservan sus copias. Esta acción no se puede deshacer en el servicio seleccionado."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcja „Usuń wszędzie” usuwa grę i jej zapisy z wybranej usługi synchronizacji oraz z urządzeń, które z niej korzystają. Kopie w innych usługach pozostają bez zmian. Tej operacji nie można cofnąć w wybranej usłudze."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "„Șterge de peste tot” elimină jocul și salvările sale din serviciul de sincronizare selectat și de pe dispozitivele care îl folosesc. Copiile din alte servicii sunt păstrate. Acțiunea nu poate fi anulată în serviciul selectat."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択中の同期サービスと、そのサービスを使うデバイスからゲームとセーブを削除します。他のサービスのコピーは残ります。選択中のサービスでは、この操作を取り消せません。"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminar em todo o lado remove o jogo e os respetivos pontos guardados do serviço de sincronização selecionado e dos dispositivos que o utilizam. Os outros serviços mantêm as respetivas cópias. Esta ação é irreversível no serviço selecionado."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「從各處刪除」會從所選同步服務及使用該服務的裝置中移除遊戲和存檔。其他服務仍會保留副本。這項操作無法在所選服務中復原。"
          }
        }
      }
    },
