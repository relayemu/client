    "Planned membership: %@. Your current plan stays in effect until Apple applies the change.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prochaine formule : %@. Ta formule actuelle reste active jusqu’au changement."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Next plan: %@. Your current plan continues until the change takes effect."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Próximo plan: %@. Tu plan actual seguirá activo hasta que se aplique el cambio."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nächster Tarif: %@. Dein aktueller Tarif läuft bis zum Wechsel weiter."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음 요금제: %@. 변경 사항이 적용될 때까지 현재 요금제가 유지됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Volgende formule: %@. Je huidige formule blijft actief tot de wijziging ingaat."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nästa plan: %@. Din nuvarande plan gäller tills ändringen träder i kraft."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prossimo piano: %@. Il tuo piano attuale resta attivo finché la modifica non diventa effettiva."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Próximo plano: %@. Seu plano atual continua até a mudança entrar em vigor."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Próximo plan: %@. Tu plan actual continúa hasta que el cambio entre en vigor."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Następny plan: %@. Obecny plan obowiązuje do czasu wejścia zmiany w życie."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Planul următor: %@. Planul tău actual continuă până când schimbarea intră în vigoare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次のプラン：%@。変更が有効になるまでは現在のプランが続きます。"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Próximo plano: %@. O teu plano atual continua até a alteração entrar em vigor."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "下一個方案：%@。目前的方案會持續到變更生效。"
          }
