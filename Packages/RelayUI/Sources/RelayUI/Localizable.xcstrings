      }
    },
    "Your current in-game save is kept as a version too. Nothing is overwritten.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta progression actuelle sera conservée : tu pourras la retrouver si besoin."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu guardado actual del juego también se conserva como una versión. No se sobrescribe nada."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein aktueller spielinterner Speicherstand bleibt ebenfalls als Version erhalten. Nichts wird überschrieben."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 게임 내 저장 데이터도 하나의 버전으로 유지됩니다. 아무것도 덮어쓰지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je huidige opgeslagen voortgang in de game blijft ook als versie bewaard. Er wordt niets overschreven."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din aktuella sparning i spelet behålls också som en version. Inget skrivs över."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Anche il salvataggio attuale nel gioco viene mantenuto come versione. Non viene sovrascritto nulla."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu salvamento atual no jogo também é mantido como uma versão. Nada é sobrescrito."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu guardado actual del juego también se conserva como una versión. No se sobrescribe nada."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bieżący zapis w grze również zostanie zachowany jako wersja. Nic nie zostanie nadpisane."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvarea ta actuală din joc este păstrată și ca versiune. Nimic nu este suprascris."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在のゲーム内セーブもバージョンとして残ります。何も上書きされません。"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O teu progresso atual guardado no jogo também é mantido como uma versão. Nada é substituído."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你目前的遊戲內存檔也會保留為一個版本，不會覆寫任何內容。"
          }
        }
      }
    },
    "Your games and saves stay on %@. Turn on iCloud in Settings to sync them.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes jeux et sauvegardes restent sur %@. Active iCloud dans les Réglages pour les synchroniser."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus juegos y guardados permanecen en %@. Activa iCloud en Ajustes para sincronizarlos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Spiele und Speicherstände bleiben auf %@. Aktiviere iCloud in den Einstellungen, um sie zu synchronisieren."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "게임과 세이브는 %@에 남아 있습니다. 동기화하려면 설정에서 iCloud를 켜세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je games en opslagpunten blijven op %@. Schakel iCloud in via Instellingen om ze te synchroniseren."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dina spel och sparningar finns kvar på %@. Slå på iCloud under Inställningar för att synkronisera dem."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi giochi e i tuoi salvataggi rimangono su %@. Attiva iCloud in Impostazioni per sincronizzarli."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus jogos e salvamentos permanecem em %@. Ative o iCloud nos Ajustes para sincronizá-los."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus juegos y guardados permanecen en %@. Activa iCloud en Configuración para sincronizarlos."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gry i zapisy pozostaną na tym urządzeniu: %@. Włącz iCloud w Ustawieniach, aby je synchronizować."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Jocurile și salvările tale rămân pe %@. Activează iCloud din Configurări pentru a le sincroniza."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゲームとセーブは%@に残ります。「設定」でiCloudをオンにすると同期できます。"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os teus jogos e pontos guardados ficam em %@. Ativa o iCloud em Definições para os sincronizares."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的遊戲和存檔會留在 %@ 上。請在「設定」中開啟 iCloud 以同步。"
          }
        }
      },
      "comment": "The sole `%@` is an already-localized current-device noun phrase such as “this iPhone” or “this Mac”. This is the body of the iCloud-off product message."
    },
