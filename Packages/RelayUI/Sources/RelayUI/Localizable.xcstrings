    "The App Store is unavailable right now. Try again later.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’App Store est indisponible pour le moment. Réessaie plus tard."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "El App Store no está disponible ahora mismo. Inténtalo de nuevo más tarde."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der App Store ist derzeit nicht verfügbar. Versuche es später erneut."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 App Store를 이용할 수 없습니다. 나중에 다시 시도하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De App Store is nu niet beschikbaar. Probeer het later opnieuw."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store är inte tillgänglig just nu. Försök igen senare."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’App Store non è disponibile al momento. Riprova più tardi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A App Store está indisponível agora. Tente novamente mais tarde."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store no está disponible en este momento. Vuelve a intentarlo más tarde."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store jest teraz niedostępny. Spróbuj ponownie później."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store nu este disponibil momentan. Încearcă din nou mai târziu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在App Storeを利用できません。しばらくしてからもう一度お試しください。"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A App Store não está disponível neste momento. Tenta novamente mais tarde."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store 目前無法使用。請稍後再試。"
          }
        }
      }
    },
    "The App Store is unavailable right now. Try again later. Your local games and saves remain available.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’App Store est indisponible pour le moment. Réessaie plus tard. Tes jeux et sauvegardes sur cet appareil restent disponibles."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "El App Store no está disponible ahora mismo. Inténtalo de nuevo más tarde. Tus juegos y guardados locales siguen disponibles."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der App Store ist derzeit nicht verfügbar. Versuche es später erneut. Deine lokalen Spiele und Speicherstände bleiben verfügbar."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 App Store를 이용할 수 없습니다. 나중에 다시 시도하세요. 이 기기의 게임과 세이브는 계속 이용할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De App Store is nu niet beschikbaar. Probeer het later opnieuw. Je lokale games en opslagpunten blijven beschikbaar."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store är inte tillgänglig just nu. Försök igen senare. Dina lokala spel och sparningar är fortfarande tillgängliga."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’App Store non è disponibile al momento. Riprova più tardi. I tuoi giochi e i tuoi salvataggi locali restano disponibili."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A App Store está indisponível agora. Tente novamente mais tarde. Seus jogos e salvamentos locais continuam disponíveis."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store no está disponible en este momento. Vuelve a intentarlo más tarde. Tus juegos y guardados de este dispositivo siguen disponibles."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store jest teraz niedostępny. Spróbuj ponownie później. Lokalne gry i zapisy pozostają dostępne."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store nu este disponibil momentan. Încearcă din nou mai târziu. Jocurile și salvările de pe acest dispozitiv rămân disponibile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在App Storeを利用できません。しばらくしてからもう一度お試しください。ローカルのゲームとセーブは引き続き利用できます。"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A App Store não está disponível neste momento. Tenta novamente mais tarde. Os teus jogos e pontos guardados neste dispositivo continuam disponíveis."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store 目前無法使用。請稍後再試。你的本機遊戲和存檔仍可使用。"
          }
        }
      }
    },
    "The Relay name, the Baton mark and the app icon are Relay's own and stay with the official app.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nom Relay, le Baton et l’icône de l’app appartiennent à Relay et restent ceux de l’app officielle."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "El nombre Relay, la marca Baton y el icono de la app pertenecen a Relay y se reservan para la app oficial."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Name Relay, die Baton-Bildmarke und das App-Symbol gehören Relay und bleiben der offiziellen App vorbehalten."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay 이름, Baton 마크 및 앱 아이콘은 Relay 고유 자산이며 공식 앱에서만 사용됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De naam Relay, het Baton-logo en het appicoon zijn van Relay en blijven bij de officiële app."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Namnet Relay, Baton-märket och appsymbolen tillhör Relay och hör till den officiella appen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il nome Relay, il simbolo Baton e l’icona dell’app sono di proprietà di Relay e rimangono nell’app ufficiale."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O nome Relay, a marca Baton e o ícone do aplicativo são próprios do Relay e permanecem com o aplicativo oficial."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "El nombre Relay, la marca Baton y el ícono de la app pertenecen a Relay y se reservan para la app oficial."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nazwa Relay, znak Baton i ikona aplikacji należą do Relay i pozostają częścią oficjalnej aplikacji."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Numele Relay, marca Baton și pictograma aplicației aparțin Relay și rămân asociate aplicației oficiale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Relayの名称、Batonマーク、アプリアイコンはRelay独自のものであり、公式アプリにのみ使用されます。"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O nome Relay, a marca Baton e o ícone da app são do Relay e mantêm-se associados à app oficial."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay 名稱、Baton 標誌和 App 圖示均為 Relay 所有，僅供官方 App 使用。"
          }
        }
      }
    },
    "The Siri Remote gets you around. Games want a controller: pair one in Settings ▸ Remotes and Devices, then press any button.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La télécommande Siri sert à naviguer. Pour jouer, il te faut une manette : jumelle-la dans Réglages ▸ Télécommandes et appareils, puis appuie sur n’importe quel bouton."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "El Siri Remote sirve para desplazarte. Para jugar necesitas un mando: enlázalo en Ajustes ▸ Mandos y dispositivos y pulsa cualquier botón."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit der Siri Remote navigierst du. Spiele benötigen einen Controller: Kopple ihn unter Einstellungen ▸ Fernbedienungen und Geräte und drücke dann eine beliebige Taste."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri Remote로 탐색할 수 있습니다. 게임에는 컨트롤러가 필요합니다. 설정 ▸ 리모컨 및 기기에서 컨트롤러를 페어링한 다음 아무 버튼이나 누르세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Met de Siri Remote navigeer je door de app. Games hebben een controller nodig: koppel er een via Instellingen ▸ Afstandsbedieningen en apparaten en druk op een knop."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Använd Siri Remote för att navigera. Spel kräver en handkontroll: parkoppla en under Inställningar ▸ Fjärrkontroller och enheter och tryck sedan på valfri knapp."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con Siri Remote puoi navigare. Per giocare serve un controller: abbinalo in Impostazioni ▸ Telecomandi e dispositivi, poi premi un pulsante qualsiasi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use o Siri Remote para navegar. Para jogar, use um controle: emparelhe-o em Ajustes ▸ Controles Remotos e Dispositivos e pressione qualquer botão."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "El Siri Remote sirve para navegar. Para jugar necesitas un control: enlaza uno en Configuración ▸ Controles remotos y dispositivos y luego presiona cualquier botón."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilot Siri Remote pozwala poruszać się po aplikacji. Do gier potrzebujesz kontrolera: połącz go w menu Ustawienia ▸ Piloty i urządzenia, a następnie naciśnij dowolny przycisk."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Telecomanda Siri te ajută să navighezi. Jocurile necesită un controler: asociază unul din Configurări ▸ Telecomenzi și dispozitive, apoi apasă orice buton."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri Remoteで画面を操作できます。ゲームにはコントローラーが必要です。「設定」▸「リモコンとデバイス」でペアリングし、いずれかのボタンを押してください。"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Siri Remote permite-te navegar. Para jogar, precisas de um comando: emparelha um em Definições ▸ Comandos e dispositivos e, depois, prime qualquer botão."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你可以使用 Siri Remote 瀏覽。遊戲需要控制器：請前往「設定」>「遙控器與裝置」配對控制器，然後按下任一按鈕。"
          }
        }
      }
    },
    "The archive is larger than Relay can safely unpack, or it isn't a plain ZIP. Unzip it and import the game files directly.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Décompresse l’archive, puis importe les fichiers de jeu qu’elle contient."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unzip the archive, then import the game files inside."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Descomprime el archivo e importa los archivos de juego que contiene."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entpacke das Archiv und importiere dann die enthaltenen Spieldateien."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "압축 파일을 푼 다음 안에 있는 게임 파일을 가져오세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pak het archief uit en importeer daarna de gamebestanden uit het archief."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Packa upp arkivet och importera sedan spelfilerna i arkivet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Decomprimi l’archivio, quindi importa i file di gioco al suo interno."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Descompacte o arquivo e importe os arquivos de jogo que estão dentro dele."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Descomprime el archivo y luego importa los archivos del juego que contiene."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozpakuj archiwum, a następnie zaimportuj znajdujące się w nim pliki gier."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Extrage conținutul arhivei, apoi importă fișierele jocului din interior."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アーカイブを展開してから、中のゲームファイルを読み込んでください。"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Descompacta o ficheiro e, depois, importa os ficheiros de jogo que contém."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請解開壓縮檔，再匯入其中的遊戲檔案。"
          }
        }
      }
    },
    "The archive opened fine but nothing inside looks like a game.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifie les formats compatibles, puis importe un fichier de jeu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the supported formats, then import a game file."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Consulta los formatos compatibles e importa un archivo de juego."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfe die unterstützten Formate und importiere dann eine Spieldatei."
          }
        },
