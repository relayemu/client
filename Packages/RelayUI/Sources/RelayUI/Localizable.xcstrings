    "Add games on your iPhone, iPad or Mac. With iCloud on, your library and saves appear here. Game files follow too when you turn on game-file sync.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute tes jeux sur ton iPhone, ton iPad ou ton Mac, puis active iCloud et « Synchroniser les fichiers de jeu » pour jouer ici."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add games on your iPhone, iPad or Mac, then turn on iCloud and Sync game files to play them here."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade juegos en tu iPhone, iPad o Mac y activa iCloud y «Sincronizar archivos de juego» para jugar aquí."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge Spiele auf deinem iPhone, iPad oder Mac hinzu. Aktiviere dann iCloud und „Spieldateien synchronisieren“, um sie hier zu spielen."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone, iPad 또는 Mac에서 게임을 추가한 다음, 여기서 플레이하려면 iCloud와 게임 파일 동기화를 켜세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg games toe op je iPhone, iPad of Mac. Schakel daarna iCloud en Gamebestanden synchroniseren in om ze hier te spelen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lägg till spel på din iPhone, iPad eller Mac. Slå sedan på iCloud och Synka spelfiler för att spela dem här."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi giochi su iPhone, iPad o Mac, quindi attiva iCloud e Sincronizza i file di gioco per giocarci qui."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione jogos no seu iPhone, iPad ou Mac. Depois, ative o iCloud e Sincronizar arquivos de jogo para jogar aqui."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Agrega juegos en tu iPhone, iPad o Mac, luego activa iCloud y Sincronizar archivos de juego para jugarlos aquí."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj gry na iPhonie, iPadzie lub Macu, a następnie włącz iCloud i opcję „Synchronizuj pliki gier”, aby grać w nie tutaj."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Adaugă jocuri pe iPhone, iPad sau Mac, apoi activează iCloud și „Sincronizează fișierele jocurilor” ca să le poți juca aici."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone、iPad、Macでゲームを追加し、iCloudと「ゲームファイルを同期」をオンにすると、ここでプレイできます。"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Adiciona jogos no teu iPhone, iPad ou Mac e, depois, ativa o iCloud e Sincronizar ficheiros de jogo para jogares aqui."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在 iPhone、iPad 或 Mac 上加入遊戲，然後開啟 iCloud 和「同步遊戲檔案」，即可在此遊玩。"
          }
        }
      }
    },
    "Add games on your iPhone, iPad, or Mac. Games can't be added on Apple TV yet.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute tes jeux sur un iPhone, un iPad ou un Mac."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add your games on an iPhone, iPad or Mac."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade tus juegos en un iPhone, iPad o Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge deine Spiele auf einem iPhone, iPad oder Mac hinzu."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone, iPad 또는 Mac에서 게임을 추가하세요."
          }
        },
        "nl": {
