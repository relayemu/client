    "Add the game files on this device to keep playing.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add the game files on this device to keep playing."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute les fichiers du jeu sur cet appareil pour continuer à jouer."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade los archivos del juego a este dispositivo para seguir jugando."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge die Spieldateien auf diesem Gerät hinzu, um weiterzuspielen."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계속 플레이하려면 이 기기에 게임 파일을 추가하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg de gamebestanden op dit apparaat toe om verder te spelen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lägg till spelfilerna på den här enheten för att fortsätta spela."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi i file di gioco su questo dispositivo per continuare a giocare."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione os arquivos de jogo neste dispositivo para continuar jogando."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Agrega los archivos del juego a este dispositivo para seguir jugando."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj pliki gry na tym urządzeniu, aby kontynuować rozgrywkę."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Adaugă fișierele jocului pe acest dispozitiv ca să continui să joci."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プレイを続けるには、このデバイスにゲームファイルを追加してください。"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Adiciona os ficheiros de jogo neste dispositivo para continuares a jogar."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在此裝置加入遊戲檔案，以繼續遊玩。"
          }
        }
      }
    },
    "Relay will stop checking achievements for the current game. Gameplay continues.": {
      "comment": "Disconnect consequence while a game has an active RetroAchievements session and no pending results.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay will stop checking achievements for the current game. Gameplay continues."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay cessera de vérifier les succès pour le jeu en cours. Tu pourras continuer à jouer."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay dejará de comprobar los logros del juego actual. La partida continuará."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay prüft für das aktuelle Spiel keine Erfolge mehr. Das Spiel läuft weiter."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay가 현재 게임의 도전 과제 확인을 중지합니다. 게임플레이는 계속됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay stopt met het controleren van prestaties voor de huidige game. Je blijft doorspelen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay slutar kontrollera prestationer för det aktuella spelet. Spelet fortsätter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay interromperà il controllo degli obiettivi per il gioco corrente. Il gioco continua."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Relay deixará de verificar conquistas no jogo atual. O jogo continuará."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay dejará de verificar los logros del juego actual. El juego continúa."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay przestanie sprawdzać osiągnięcia w bieżącej grze. Rozgrywka będzie kontynuowana."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay nu va mai verifica realizările pentru jocul curent. Jocul continuă."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在のゲームで実績の確認を停止します。ゲームプレイは続きます。"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Relay deixará de verificar as conquistas do jogo atual. O jogo continua."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay 會停止檢查目前遊戲的成就。遊戲會繼續。"
          }
        }
      }
    },
    "Relay will stop checking achievements for the current game. Achievements waiting to send will be removed from this device. Achievements already on your RetroAchievements account stay there.": {
      "comment": "Destructive disconnect consequence while a game is active and achievement results are waiting to send.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay will stop checking achievements for the current game. Achievements waiting to send will be removed from this device. Achievements already on your RetroAchievements account stay there."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay cessera de vérifier les succès pour le jeu en cours. Les succès en attente d’envoi seront supprimés de cet appareil. Les succès déjà enregistrés sur ton compte RetroAchievements y resteront."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay dejará de comprobar los logros del juego actual. Los logros pendientes de enviar se eliminarán de este dispositivo. Los que ya estén en tu cuenta de RetroAchievements seguirán allí."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay prüft für das aktuelle Spiel keine Erfolge mehr. Noch nicht gesendete Erfolge werden von diesem Gerät entfernt. Erfolge, die bereits in deinem RetroAchievements-Account sind, bleiben dort."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay가 현재 게임의 도전 과제 확인을 중지합니다. 전송 대기 중인 도전 과제는 이 기기에서 삭제됩니다. RetroAchievements 계정에 이미 있는 도전 과제는 그대로 유지됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay stopt met het controleren van prestaties voor de huidige game. Prestaties die op verzending wachten, worden van dit apparaat verwijderd. Prestaties die al in je RetroAchievements-account staan, blijven daar."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay slutar kontrollera prestationer för det aktuella spelet. Prestationer som väntar på att skickas tas bort från den här enheten. Prestationer som redan finns på ditt RetroAchievements-konto finns kvar där."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay interromperà il controllo degli obiettivi per il gioco corrente. Gli obiettivi in attesa di invio verranno rimossi da questo dispositivo. Quelli già presenti nel tuo account RetroAchievements resteranno nell’account."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Relay deixará de verificar conquistas no jogo atual. As conquistas aguardando envio serão removidas deste dispositivo. As conquistas que já estão na sua conta do RetroAchievements continuarão lá."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay dejará de verificar los logros del juego actual. Los logros que estén pendientes de enviarse se eliminarán de este dispositivo. Los logros que ya están en tu cuenta de RetroAchievements permanecerán ahí."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay przestanie sprawdzać osiągnięcia w bieżącej grze. Osiągnięcia czekające na wysłanie zostaną usunięte z tego urządzenia. Osiągnięcia znajdujące się już na Twoim koncie RetroAchievements pozostaną na nim."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay nu va mai verifica realizările pentru jocul curent. Realizările care așteaptă să fie trimise vor fi eliminate de pe acest dispozitiv. Cele aflate deja în contul tău RetroAchievements rămân acolo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在のゲームで実績の確認を停止します。送信待ちの実績はこのデバイスから削除されます。RetroAchievementsアカウントに送信済みの実績は残ります。"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Relay deixará de verificar as conquistas do jogo atual. Os resultados de conquistas a aguardar envio serão removidos deste dispositivo. As conquistas que já estão na tua conta RetroAchievements permanecem lá."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay 會停止檢查目前遊戲的成就。等待傳送的成就將從此裝置移除。已在你的 RetroAchievements 帳號中的成就會保留。"
          }
        }
      }
    },
