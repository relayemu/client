    "Your export is still available. Try saving it in another location.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your export is still available. Try saving it in another location."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton export est toujours disponible. Essaie de l’enregistrer ailleurs."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu exportación sigue disponible. Prueba a guardarla en otra ubicación."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Export ist noch verfügbar. Versuche, ihn an einem anderen Ort zu speichern."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내보낸 항목은 계속 사용할 수 있습니다. 다른 위치에 저장해 보세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je export is nog beschikbaar. Probeer deze op een andere locatie op te slaan."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Exporten är fortfarande tillgänglig. Försök spara den på en annan plats."
          }
        },
        "it": {
