          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditt köp har sparats. Slutför inställningen när du är online. Du behöver inte köpa igen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’acquisto è registrato. Completa la configurazione quando sei online. Non devi acquistare di nuovo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua compra está salva. Conclua a configuração quando estiver online. Você não precisa comprar novamente."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu compra está registrada. Finaliza la configuración cuando vuelvas a tener conexión. No tienes que comprarla de nuevo."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zakup został zapisany. Dokończ konfigurację po połączeniu z internetem. Nie musisz kupować ponownie."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Achiziția ta a fost înregistrată. Finalizează configurarea când ești online. Nu trebuie să cumperi din nou."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "購入情報は保存されています。オンラインになったら設定を完了してください。再購入は不要です。"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A tua compra está guardada. Conclui a configuração quando estiveres online. Não precisas de comprar novamente."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的購買紀錄已保留。請在連上網路後完成設定，無須再次購買。"
          }
        }
      }
    },
    "Your Relay Sync storage is full. Download or manage your files in the account portal.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay Sync storage is full. Manage your files online to make room."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le stockage Relay Sync est plein. Gère tes fichiers en ligne pour libérer de l’espace."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "El almacenamiento de Relay Sync está lleno. Gestiona tus archivos en línea para liberar espacio."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Relay Sync-Speicher ist voll. Verwalte deine Dateien online, um Platz zu schaffen."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay Sync 저장 공간이 가득 찼습니다. 공간을 확보하려면 온라인에서 파일을 관리하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De opslag van Relay Sync is vol. Beheer je bestanden online om ruimte te maken."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lagringsutrymmet i Relay Sync är fullt. Hantera dina filer online för att frigöra utrymme."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo spazio di Relay Sync è esaurito. Gestisci i file online per liberare spazio."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O armazenamento do Relay Sync está cheio. Gerencie seus arquivos online para liberar espaço."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "El almacenamiento de Relay Sync está lleno. Administra tus archivos en línea para liberar espacio."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Miejsce w Relay Sync jest pełne. Zarządzaj plikami online, aby zwolnić miejsce."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Spațiul de stocare Relay Sync este plin. Gestionează fișierele online pentru a elibera spațiu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay Syncストレージがいっぱいです。オンラインでファイルを管理して空き容量を増やしてください。"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O armazenamento do Relay Sync está cheio. Gere os teus ficheiros online para libertar espaço."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay Sync 儲存空間已滿。請在線上管理檔案以釋出空間。"
          }
        }
      }
    },
    "Your controller disconnected.": {
      "localizations": {
        "fr": {
