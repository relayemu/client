    "Press and hold a game to add one.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur un jeu, maintiens le bouton de sélection pour l’ajouter aux favoris."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pulsado un juego para añadirlo a favoritos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte ein Spiel gedrückt, um eines hinzuzufügen."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "게임을 길게 눌러 추가하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd een game ingedrukt om er een toe te voegen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck och håll ned på ett spel för att lägga till det som favorit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuto un gioco per aggiungerlo ai preferiti."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pressione e segure um jogo para adicionar um."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén presionado el botón de selección sobre un juego para agregarlo a favoritos."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Naciśnij i przytrzymaj grę, aby dodać kod."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ține apăsat pe un joc ca să-l adaugi la favorite."
          }
        },
        "ja": {
