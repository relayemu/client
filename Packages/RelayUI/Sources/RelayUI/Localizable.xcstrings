    "Relay Sync cannot automatically remove older save history yet. Your local saves are safe. You can keep playing while this sync action is paused.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some older online saves couldn’t be removed. You can keep playing."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certaines anciennes sauvegardes en ligne n’ont pas pu être supprimées. Tu peux continuer à jouer."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "No se han podido eliminar algunos guardados antiguos en línea. Puedes seguir jugando."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige ältere Online-Speicherstände konnten nicht gelöscht werden. Du kannst weiterspielen."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일부 오래된 온라인 세이브를 삭제하지 못했습니다. 계속 플레이할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Enkele oudere online opslagpunten konden niet worden verwijderd. Je kunt blijven spelen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vissa äldre sparningar online kunde inte tas bort. Du kan fortsätta spela."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile eliminare alcuni salvataggi online meno recenti. Puoi continuare a giocare."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível apagar alguns salvamentos antigos online. Você pode continuar jogando."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron eliminar algunos guardados antiguos en línea. Puedes seguir jugando."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się usunąć niektórych starszych zapisów online. Możesz grać dalej."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Unele salvări online mai vechi nu au putut fi șterse. Poți continua să joci."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンラインにある一部の古いセーブを削除できませんでした。プレイは続けられます。"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível eliminar alguns pontos guardados antigos online. Podes continuar a jogar."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "部分較舊的線上存檔無法刪除。你可以繼續遊玩。"
          }
        }
      }
    },
    "Relay Sync couldn't connect. Check your connection and try again. Your local progress is safe.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay Sync couldn't connect. Check your connection and try again. Your local progress is safe."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay Sync n’a pas pu se connecter. Vérifie ta connexion et réessaie. Ta progression locale est en sécurité."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay Sync no se ha podido conectar. Comprueba tu conexión y vuelve a intentarlo. Tu progreso local está a salvo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay Sync konnte keine Verbindung herstellen. Prüfe deine Verbindung und versuche es erneut. Dein lokaler Fortschritt ist sicher."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay Sync에 연결하지 못했습니다. 연결 상태를 확인하고 다시 시도하세요. 이 기기의 진행 상황은 안전합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay Sync kon geen verbinding maken. Controleer je verbinding en probeer het opnieuw. Je lokale voortgang is veilig."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay Sync kunde inte ansluta. Kontrollera anslutningen och försök igen. Dina lokala framsteg är säkra."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay Sync non è riuscito a connettersi. Controlla la connessione e riprova. I tuoi progressi locali sono al sicuro."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Relay Sync não conseguiu se conectar. Verifique sua conexão e tente novamente. Seu progresso local está seguro."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay Sync no pudo conectarse. Revisa tu conexión y vuelve a intentarlo. Tu progreso local está seguro."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay Sync nie może nawiązać połączenia. Sprawdź połączenie i spróbuj ponownie. Lokalne postępy są bezpieczne."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay Sync nu s-a putut conecta. Verifică conexiunea și încearcă din nou. Progresul tău local este în siguranță."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay Syncに接続できませんでした。接続を確認して、もう一度お試しください。ローカルの進行状況は失われません。"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ligar ao Relay Sync. Verifica a tua ligação e tenta novamente. O teu progresso local está seguro."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay Sync 無法連線。請檢查網路連線後再試一次。你的本機進度不受影響。"
          }
        }
      }
    },
