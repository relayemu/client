    "Pro Monthly, Sync and Sync+ are options in one Apple subscription group. Choose Sync to upgrade from Pro Monthly, or Sync+ for more storage. Apple shows the price and when a change takes effect before you confirm.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch between Pro Monthly, Sync and Sync+. Apple shows the price and start date before you confirm."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Change d’offre entre Pro Mensuel, Sync et Sync+. Apple t’indique le prix et la date de début avant ta confirmation."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia entre Pro mensual, Sync y Sync+. Apple muestra el precio y la fecha de inicio antes de que confirmes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wechsle zwischen Pro monatlich, Sync und Sync+. Apple zeigt Preis und Startdatum vor deiner Bestätigung."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay Pro 월간, Relay Sync 및 Relay Sync+ 간에 전환할 수 있습니다. 확인 전에 Apple이 가격과 시작일을 표시합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wissel tussen Pro Monthly, Sync en Sync+. Apple toont de prijs en ingangsdatum voordat je bevestigt."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Växla mellan Relay Pro månadsvis, Relay Sync och Relay Sync+. Apple visar priset och startdatumet innan du bekräftar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli tra Pro Mensile, Sync e Sync+. Apple mostra il prezzo e la data di inizio prima della conferma."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alterne entre Pro Monthly, Sync e Sync+. A Apple mostra o preço e a data de início antes de você confirmar."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia entre Pro Monthly, Sync y Sync+. Apple muestra el precio y la fecha de inicio antes de confirmar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przełączaj się między planami Pro Monthly, Sync i Sync+. Przed potwierdzeniem Apple pokaże cenę oraz datę wejścia zmiany w życie."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Comută între Pro Monthly, Sync și Sync+. Apple afișează prețul și data de începere înainte să confirmi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro Monthly、Sync、Sync+を切り替えられます。確定前にAppleが価格と開始日を表示します。"
          }
        },
        "pt-PT": {
