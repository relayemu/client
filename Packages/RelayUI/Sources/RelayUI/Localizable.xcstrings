            "value": "Gravar o jogo"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "錄製遊戲過程"
          }
        }
      }
    },
    "Record gameplay without a plan-imposed time limit. Storage and device safety limits still apply.": {
      "comment": "Relay Pro has no plan-imposed duration cap; storage and runtime safety may still end recording.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record gameplay without a plan-imposed time limit. Storage and device safety limits still apply."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistre tes parties sans limite de durée imposée par la formule. Les limites de stockage et de sécurité de l’appareil s’appliquent toujours."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Graba partidas sin límite de tiempo impuesto por el plan. Siguen aplicándose los límites de almacenamiento y seguridad del dispositivo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimm Gameplay ohne tarifbedingtes Zeitlimit auf. Speicherplatz und Gerätesicherheit können die Aufnahme weiterhin beenden."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "요금제에서 정한 시간 제한 없이 게임플레이를 녹화할 수 있습니다. 저장 공간 및 기기 안전 제한은 계속 적용됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Neem gameplay op zonder vaste tijdslimiet. De opname kan nog steeds stoppen door te weinig opslagruimte of om je apparaat te beschermen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Planen har ingen tidsgräns för inspelningar. Lagringsutrymmet och enhetens säkerhetsgränser kan ändå begränsa inspelningens längd."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra il gameplay senza limiti di durata imposti dal piano. Restano validi i limiti di spazio e di sicurezza del dispositivo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Grave o gameplay sem limite de tempo imposto pelo plano. Os limites de armazenamento e de segurança do dispositivo ainda se aplicam."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Graba la partida sin un límite de tiempo impuesto por el plan. Aun así, se aplican los límites de almacenamiento y seguridad del dispositivo."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagrywaj rozgrywkę bez limitu czasu narzuconego przez plan. Nadal obowiązują ograniczenia wynikające z dostępnego miejsca i bezpieczeństwa urządzenia."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Înregistrează jocul fără o limită de timp impusă de plan. Limitele de stocare și de siguranță ale dispozitivului se aplică în continuare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プランによる時間制限なしでゲームプレイを録画できます。ストレージ容量やデバイス保護による制限は引き続き適用されます。"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Grava o jogo sem um limite de tempo imposto pelo plano. Continuam a aplicar-se os limites de armazenamento e de segurança do dispositivo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "錄製遊戲過程，不受方案時間上限限制。儲存空間及裝置安全限制仍適用。"
          }
        }
      }
    },
    "Recording stopped because storage is low. Share any ready recording before starting another.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recording stopped because storage is low. Share any ready recording before starting another."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’enregistrement s’est arrêté par manque d’espace. Partage tout enregistrement prêt avant d’en commencer un autre."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "La grabación se ha detenido por falta de espacio. Comparte cualquier grabación que esté lista antes de iniciar otra."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Aufnahme wurde wegen zu wenig Speicherplatz beendet. Teile eine fertige Aufnahme, bevor du eine neue startest."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장 공간이 부족하여 녹화가 중지되었습니다. 완료된 녹화본이 있다면 새 녹화를 시작하기 전에 공유하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De opname is gestopt wegens weinig opslagruimte. Deel een opname die klaarstaat voordat je een nieuwe start."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inspelningen stoppades på grund av för lite lagringsutrymme. Dela en färdig inspelning innan du startar en ny."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La registrazione si è interrotta per mancanza di spazio. Condividi la registrazione pronta prima di iniziarne un’altra."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A gravação parou porque há pouco espaço de armazenamento. Compartilhe qualquer gravação pronta antes de iniciar outra."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "La grabación se detuvo porque queda poco espacio. Comparte cualquier grabación que esté lista antes de iniciar otra."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagrywanie zatrzymano z powodu małej ilości wolnego miejsca. Przed rozpoczęciem kolejnego udostępnij gotowe nagranie."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Înregistrarea s-a oprit deoarece spațiul liber este insuficient. Partajează orice înregistrare disponibilă înainte să începi alta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ストレージの空き容量が少ないため録画を停止しました。共有できる録画があれば共有してから、次の録画を開始してください。"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A gravação parou por falta de espaço de armazenamento. Partilha qualquer gravação pronta antes de iniciares outra."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "儲存空間不足，錄製已停止。若已有完成的錄製內容，請先分享再錄製下一段。"
          }
        }
      }
    },
    "Relay couldn't check the available storage. Recording has stopped.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay couldn't check the available storage. Recording has stopped."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay n’a pas pu vérifier l’espace disponible. L’enregistrement s’est arrêté."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay no ha podido comprobar el espacio disponible. La grabación se ha detenido."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay konnte den verfügbaren Speicherplatz nicht prüfen. Die Aufnahme wurde beendet."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay가 사용 가능한 저장 공간을 확인하지 못해 녹화가 중지되었습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay kon de beschikbare opslagruimte niet controleren. De opname is gestopt."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay kunde inte kontrollera det tillgängliga lagringsutrymmet. Inspelningen har stoppats."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay non ha potuto verificare lo spazio disponibile. La registrazione si è interrotta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Relay não conseguiu verificar o armazenamento disponível. A gravação parou."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay no pudo verificar el almacenamiento disponible. La grabación se detuvo."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay nie może sprawdzić ilości wolnego miejsca. Nagrywanie zostało zatrzymane."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay nu a putut verifica spațiul de stocare disponibil. Înregistrarea s-a oprit."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "空き容量を確認できなかったため、Relayは録画を停止しました。"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Relay não conseguiu verificar o armazenamento disponível. A gravação parou."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay 無法檢查可用的儲存空間。錄製已停止。"
          }
        }
      }
    },
