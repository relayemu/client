    "Loading Saves is unavailable in Hardcore. You can still create Saves.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loading Saves is unavailable in Hardcore. You can still create Saves."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le chargement des sauvegardes est indisponible en mode Hardcore. Tu peux toujours créer des sauvegardes."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pueden cargar guardados en Hardcore. Puedes seguir creándolos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay-Speicherstände können in Hardcore nicht geladen werden. Du kannst weiterhin Relay-Speicherstände erstellen."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Hardcore에서는 세이브를 불러올 수 없습니다. 세이브는 계속 만들 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opslagpunten laden is niet beschikbaar in Hardcore. Je kunt nog steeds opslagpunten maken."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det går inte att läsa in sparningar i Hardcore. Du kan fortfarande skapa sparningar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In Hardcore non puoi caricare i salvataggi. Puoi comunque crearli."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Carregar Salvamentos não está disponível no Hardcore. Você ainda pode criar Salvamentos."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "No puedes cargar guardados en Hardcore. Aún puedes crear guardados."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wczytywanie Zapisów jest niedostępne w trybie Hardcore. Nadal możesz tworzyć Zapisy."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Încărcarea salvărilor Relay nu este disponibilă în modul Hardcore. Poți crea în continuare salvări Relay."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Hardcoreではセーブを読み込めません。セーブは引き続き作成できます。"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Carregar pontos guardados não está disponível no modo Hardcore. Ainda podes criar pontos guardados."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Hardcore 模式下無法載入存檔。你仍可建立存檔。"
          }
        }
      }
    },
