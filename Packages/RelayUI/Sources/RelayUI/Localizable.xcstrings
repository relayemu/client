    "It has a %@ name but not the contents of a game. Try another copy of the file.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce fichier ne peut pas être lu comme un jeu %@. Essaie une autre copie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This file can’t be read as a %@ game. Try another copy."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Este archivo no se puede leer como un juego de %@. Prueba con otra copia."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Datei kann nicht als %@-Spiel gelesen werden. Probiere eine andere Kopie."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 파일을 %@ 게임으로 읽을 수 없습니다. 다른 사본을 사용해 보세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit bestand kan niet als %@-game worden gelezen. Probeer een andere kopie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Filen kan inte läsas som ett %@-spel. Prova en annan kopia."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo file non può essere letto come gioco per %@. Prova un’altra copia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este arquivo não pode ser lido como um jogo de %@. Tente outra cópia."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Este archivo no se puede leer como un juego de %@. Prueba con otra copia."
