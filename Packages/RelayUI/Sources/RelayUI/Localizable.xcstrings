    "Older in-game saves, including versions you didn't keep. Restoring one keeps your current progress as a version too.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retrouve une ancienne sauvegarde du jeu. Ta progression actuelle sera conservée."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restore an earlier in-game save. Your current progress will be kept too."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaura un guardado anterior del juego. Tu progreso actual también se conservará."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stelle einen früheren spielinternen Speicherstand wieder her. Dein aktueller Fortschritt bleibt ebenfalls erhalten."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이전 게임 내 저장 데이터를 복원합니다. 현재 진행 상황도 함께 유지됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Herstel eerder in de game opgeslagen voortgang. Je huidige voortgang wordt ook behouden."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Återställ en tidigare sparning i spelet. Dina aktuella framsteg behålls också."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ripristina un salvataggio precedente nel gioco. Anche i tuoi progressi attuali verranno mantenuti."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaure um salvamento anterior no jogo. Seu progresso atual também será mantido."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaura un guardado anterior del juego. Tu progreso actual también se conservará."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przywróć wcześniejszy zapis w grze. Bieżące postępy również zostaną zachowane."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaurează o salvare anterioară din joc. Progresul tău actual va fi păstrat și el."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "以前のゲーム内セーブを復元します。現在の進行状況もバージョンとして残ります。"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
