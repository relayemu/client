            "state": "translated",
            "value": "Não foi possível salvar seu progresso."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo guardar tu progreso."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się zapisać postępów."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Progresul tău nu a putut fi salvat."
          }
        },
