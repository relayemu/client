        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riavvia il gioco per usare gli obiettivi in modo sicuro."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Reinicie o jogo para usar as conquistas com segurança."
