    "Use validated manual cheat codes on iPhone, iPad and Mac, with a safety save made first.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute des codes de triche sur iPhone, iPad et Mac. Relay sauvegarde ta progression avant leur utilisation."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add cheat codes on iPhone, iPad and Mac. Relay saves your progress before you use them."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade códigos de trucos en iPhone, iPad y Mac. Relay guarda tu progreso antes de usarlos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge Cheat-Codes auf iPhone, iPad und Mac hinzu. Relay speichert deinen Fortschritt, bevor du sie verwendest."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone, iPad 및 Mac에서 치트 코드를 추가할 수 있습니다. 치트를 사용하기 전에 Relay가 진행 상황을 저장합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg cheatcodes toe op iPhone, iPad en Mac. Relay slaat je voortgang op voordat je ze gebruikt."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lägg till fuskkoder på iPhone, iPad och Mac. Relay sparar dina framsteg innan du använder dem."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi codici trucco su iPhone, iPad e Mac. Relay salva i tuoi progressi prima di usarli."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione códigos de trapaça no iPhone, iPad e Mac. O Relay salva seu progresso antes de você usá-los."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Agrega códigos de trucos en iPhone, iPad y Mac. Relay guarda tu progreso antes de usarlos."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodawaj kody na iPhonie, iPadzie i Macu. Relay zapisze postępy przed ich użyciem."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Adaugă coduri de trișare pe iPhone, iPad și Mac. Relay îți salvează progresul înainte să le folosești."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
