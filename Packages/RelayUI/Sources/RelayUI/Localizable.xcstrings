    "A different Relay account is connected.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A different Relay account is connected."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un autre compte Relay est connecté."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay otra Cuenta Relay conectada."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein anderer Relay Account ist verbunden."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 Relay Account가 연결되어 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is een ander Relay Account gekoppeld."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett annat Relay-konto är anslutet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È connesso un Relay Account diverso."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Outra Relay Account está conectada."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay otra Cuenta Relay conectada."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Połączono z innym Kontem Relay."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Este conectat un alt Relay Account."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別のRelay Accountが接続されています。"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Está ligada uma Relay Account diferente."
          }
