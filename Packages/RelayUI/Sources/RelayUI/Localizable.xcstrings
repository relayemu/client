    "Download your games and saves before the recovery period ends. New uploads are paused. Your local progress stays safe.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Download your games and saves before the date below. Uploads are paused. Your progress on this device is safe."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Télécharge tes jeux et sauvegardes avant la date ci-dessous. Les envois sont en pause. Ta progression sur cet appareil est en sécurité."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Descarga tus juegos y guardados antes de la fecha indicada abajo. Las subidas están en pausa. Tu progreso en este dispositivo está a salvo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lade deine Spiele und Speicherstände vor dem unten genannten Datum herunter. Uploads sind pausiert. Dein Fortschritt auf diesem Gerät ist sicher."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아래 날짜 전까지 게임과 세이브를 다운로드하세요. 업로드는 일시 정지되었습니다. 이 기기의 진행 상황은 안전하게 유지됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Download je games en opslagpunten vóór de datum hieronder. Uploads zijn gepauzeerd. Je voortgang op dit apparaat is veilig."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hämta dina spel och sparningar före datumet nedan. Uppladdningar är pausade. Dina framsteg på den här enheten är säkra."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scarica i tuoi giochi e i salvataggi prima della data indicata di seguito. I caricamenti sono in pausa. I tuoi progressi su questo dispositivo sono al sicuro."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Baixe seus jogos e salvamentos antes da data abaixo. Os envios estão pausados. Seu progresso neste dispositivo está seguro."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Descarga tus juegos y guardados antes de la fecha indicada abajo. Las subidas están en pausa. Tu progreso en este dispositivo está seguro."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pobierz swoje gry i zapisy przed podaną poniżej datą. Przesyłanie jest wstrzymane. Postępy na tym urządzeniu są bezpieczne."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Descarcă jocurile și salvările înainte de data de mai jos. Încărcările sunt în pauză. Progresul tău de pe acest dispozitiv este în siguranță."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "以下の日付までにゲームとセーブをダウンロードしてください。アップロードは一時停止中です。このデバイスの進行状況は失われません。"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Descarrega os teus jogos e pontos guardados antes da data abaixo. Os envios estão em pausa. O teu progresso neste dispositivo está seguro."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在下方日期前下載你的遊戲和存檔。上傳已暫停。這部裝置上的進度不受影響。"
          }
        }
      }
    },
