          "stringUnit": {
            "state": "translated",
            "value": "Du hast auf %@ und %@ gespielt, während sie nicht synchron waren. Wähle, welchen Fortschritt du behalten möchtest."
          }
        },
        "ko": {
          "stringUnit": {
