    "Change discs when the game asks. Then resume play.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Change discs when the game asks. Then resume play."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Change de disque lorsque le jeu te le demande. Reprends ensuite la partie."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia de disco cuando el juego te lo pida. Después, reanuda la partida."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wechsle die Disc, wenn das Spiel dazu auffordert. Setze dann das Spiel fort."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "게임에서 요청하면 디스크를 바꾸세요. 그런 다음 플레이를 재개하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wissel van schijf wanneer de game daarom vraagt. Ga daarna verder."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Byt skiva när spelet ber om det. Fortsätt sedan spela."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia disco quando richiesto dal gioco, poi riprendi a giocare."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Troque o disco quando o jogo pedir. Depois, continue jogando."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia de disco cuando el juego te lo pida. Después, reanuda la partida."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
