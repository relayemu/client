          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrollera stavningen eller lägg till spelet från en annan enhet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlla l’ortografia o aggiungi il gioco da un altro dispositivo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique a ortografia ou adicione o jogo de outro dispositivo."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisa la ortografía o agrega el juego desde otro dispositivo."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprawdź pisownię albo dodaj grę z innego urządzenia."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifică ortografia sau adaugă jocul de pe alt dispozitiv."
