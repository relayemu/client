    "A future plan change does not change your current storage. Your Relay account shows the plan Apple has made active.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un changement prévu ne modifie pas ton espace actuel. Ton compte Relay affiche l’abonnement activé par Apple."
          }
        }
      }
    },
    "A preproduction service for your Relay account. Membership options come from the App Store. Game-file uploads need a separate opt-in for this service. Relay Sync does not provide end-to-end encryption.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay Sync is in testing. Turn on Sync game files to include them. Relay Sync does not provide end-to-end encryption."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay Sync est en phase de test. Active « Synchroniser les fichiers de jeu » pour les inclure. Relay Sync n’utilise pas de chiffrement de bout en bout."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay Sync está en fase de pruebas. Activa «Sincronizar archivos de juego» para incluirlos. Relay Sync no ofrece cifrado de extremo a extremo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay Sync wird getestet. Aktiviere „Spieldateien synchronisieren“, um sie einzubeziehen. Relay Sync bietet keine Ende-zu-Ende-Verschlüsselung."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay Sync는 테스트 중입니다. 게임 파일을 포함하려면 게임 파일 동기화를 켜세요. Relay Sync는 종단 간 암호화를 제공하지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay Sync wordt getest. Schakel Gamebestanden synchroniseren in om ze mee te nemen. Relay Sync biedt geen end-to-endversleuteling."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay Sync testas. Slå på Synka spelfiler för att ta med dem. Relay Sync erbjuder inte kryptering hela vägen mellan enheterna."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay Sync è in fase di test. Attiva Sincronizza i file di gioco per includerli. Relay Sync non fornisce la crittografia end-to-end."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Relay Sync está em fase de testes. Ative Sincronizar arquivos de jogo para incluí-los. O Relay Sync não oferece criptografia de ponta a ponta."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay Sync está en fase de pruebas. Activa Sincronizar archivos de juego para incluirlos. Relay Sync no ofrece cifrado de extremo a extremo."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay Sync jest w fazie testów. Włącz opcję „Synchronizuj pliki gier”, aby je uwzględnić. Relay Sync nie zapewnia szyfrowania kompleksowego."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay Sync este în testare. Activează „Sincronizează fișierele jocurilor” pentru a le include. Relay Sync nu oferă criptare integrală."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay Syncはテスト中です。対象に含めるには「ゲームファイルを同期」をオンにしてください。Relay Syncはエンドツーエンド暗号化に対応していません。"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Relay Sync está em testes. Ativa Sincronizar ficheiros de jogo para os incluir. O Relay Sync não oferece encriptação ponto a ponto."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay Sync 目前仍在測試。開啟「同步遊戲檔案」即可納入這些檔案。Relay Sync 不提供端對端加密。"
          }
        }
      }
    },
    "A test service for your Relay account. No purchase is available here. Game-file uploads need a separate opt-in for this service. Relay Sync does not provide end-to-end encryption.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A test service for your Relay account. No purchase is available here. Game-file uploads need a separate opt-in for this service. Relay Sync does not provide end-to-end encryption."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un service de test pour ton compte Relay. Aucun achat n’est proposé ici. L’envoi de fichiers de jeu nécessite ton accord pour ce service. Relay Sync ne propose pas de chiffrement de bout en bout."
          }
        }
      }
    },
    "About": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À propos"
          }
        },
        "es-ES": {
