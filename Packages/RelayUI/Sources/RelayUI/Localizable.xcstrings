            "state": "translated",
            "value": "Entre na sua Relay Account antes de continuar."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sesión en tu Cuenta Relay antes de continuar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaloguj się na swoje Konto Relay, aby kontynuować."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Autentifică-te în Relay Account înainte de a continua."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "続ける前にRelay Accountへサインインしてください。"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sessão na tua Relay Account antes de continuares."
          }
        },
        "zh-Hant": {
