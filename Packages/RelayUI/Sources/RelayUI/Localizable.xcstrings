    "Uploads paused. Refresh your plan to check it.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uploads are paused. Refresh your account information to check access."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les envois sont en pause. Actualise les informations de ton compte pour vérifier ton accès."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Las subidas están en pausa. Actualiza la información de tu cuenta para comprobar el acceso."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Uploads sind pausiert. Lade deine Kontoinformationen neu, um den Zugriff zu prüfen."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "업로드가 일시 정지되었습니다. 계정 정보를 새로 고쳐 이용 가능 여부를 확인하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uploads zijn gepauzeerd. Laad je accountgegevens opnieuw om de toegang te controleren."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Uppladdningar är pausade. Läs in dina kontouppgifter på nytt för att kontrollera åtkomsten."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I caricamenti sono sospesi. Aggiorna le informazioni del tuo account per verificare l’accesso."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os envios estão pausados. Atualize as informações da sua conta para verificar o acesso."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Las subidas están en pausa. Actualiza la información de tu cuenta para verificar el acceso."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przesyłanie jest wstrzymane. Odśwież informacje o koncie, aby sprawdzić dostęp."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Încărcările sunt în pauză. Reîmprospătează informațiile contului pentru a verifica accesul."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アップロードは一時停止中です。アカウント情報を再読み込みして、アクセスできるか確認してください。"
          }
        },
        "pt-PT": {
          "stringUnit": {
