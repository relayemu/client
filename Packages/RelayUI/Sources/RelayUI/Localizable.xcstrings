        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu progreso de %@ está aquí. Agrega el archivo del juego en %@ para seguir jugando."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Postępy w grze „%@” są tutaj. Aby kontynuować rozgrywkę, dodaj plik gry na wskazanym urządzeniu: %@."
