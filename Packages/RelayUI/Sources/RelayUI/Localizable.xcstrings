    "Covers of recognized games come from Relay's servers in the EU. Requests carry no account or device identifier.": {
      "comment": "Settings ▸ Library: footer under Download Covers. Covers are box art; the servers are Relay's own, in the European Union. Requests identify no account and no device.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Covers of recognized games come from Relay’s servers in the EU. Requests carry no account or device identifier."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les jaquettes des jeux reconnus viennent des serveurs de Relay dans l’UE. Les requêtes ne contiennent aucun identifiant de compte ou d’appareil."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Cover erkannter Spiele kommen von Relays Servern in der EU. Anfragen enthalten keine Konto- oder Gerätekennung."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Las portadas de los juegos reconocidos proceden de los servidores de Relay en la UE. Las solicitudes no incluyen identificadores de cuenta ni de dispositivo."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Las portadas de los juegos reconocidos provienen de los servidores de Relay en la UE. Las solicitudes no incluyen identificadores de cuenta ni de dispositivo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le copertine dei giochi riconosciuti arrivano dai server di Relay nell’UE. Le richieste non includono identificativi dell’account o del dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "認識されたゲームのカバーアートは、EU内にあるRelayのサーバから取得されます。リクエストにアカウントやデバイスの識別子は含まれません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인식된 게임의 커버 이미지는 EU에 있는 Relay 서버에서 가져옵니다. 요청에는 계정이나 기기 식별자가 포함되지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Covers van herkende games komen van de servers van Relay in de EU. Verzoeken bevatten geen account- of apparaat-ID."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Okładki rozpoznanych gier pochodzą z serwerów Relay w UE. Żądania nie zawierają identyfikatora konta ani urządzenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As capas dos jogos reconhecidos vêm dos servidores do Relay na UE. As solicitações não incluem identificadores de conta nem de dispositivo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As capas dos jogos reconhecidos vêm dos servidores do Relay na UE. Os pedidos não incluem identificadores de conta nem de dispositivo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Coperțile jocurilor recunoscute provin de pe serverele Relay din UE. Solicitările nu includ identificatori de cont sau de dispozitiv."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Omslag för igenkända spel kommer från Relays servrar i EU. Förfrågningar innehåller ingen konto- eller enhetsidentifierare."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已辨識遊戲的封面來自 Relay 位於歐盟的伺服器。請求不含任何帳號或裝置識別碼。"
          }
        }
      }
    },
