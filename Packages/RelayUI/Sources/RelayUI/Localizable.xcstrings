    "You played %@ on two devices while they were out of sync. Choose which progress to keep.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu as joué à %@ sur deux appareils sans qu’ils soient synchronisés. Choisis la progression à garder."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Has jugado a %@ en dos dispositivos mientras no estaban sincronizados. Elige qué progreso conservar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast %@ auf zwei Geräten gespielt, während sie nicht synchron waren. Wähle, welchen Fortschritt du behalten möchtest."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "동기화되지 않은 상태에서 두 기기로 %@ 게임을 플레이했습니다. 유지할 진행 상황을 선택하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hebt %@ op twee apparaten gespeeld terwijl ze niet waren gesynchroniseerd. Kies welke voortgang je wilt behouden."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du spelade %@ på två enheter medan de inte var synkroniserade. Välj vilka framsteg du vill behålla."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai giocato a %@ su due dispositivi mentre non erano sincronizzati. Scegli quale avanzamento mantenere."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você jogou %@ em dois dispositivos enquanto eles estavam fora de sincronia. Escolha qual progresso deseja manter."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Jugaste %@ en dos dispositivos mientras no estaban sincronizados. Elige qué progreso conservar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Grałeś w „%@” na dwóch urządzeniach, gdy nie były zsynchronizowane. Wybierz postępy, które chcesz zachować."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ai jucat %@ pe două dispozitive cât timp acestea nu erau sincronizate. Alege progresul pe care vrei să-l păstrezi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同期されていない間に2台のデバイスで%@をプレイしました。残す進行状況を選択してください。"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Jogaste %@ em dois dispositivos enquanto estavam dessincronizados. Escolhe o progresso que queres manter."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你曾在兩部尚未同步的裝置上遊玩「%@」。請選擇要保留的進度。"
          }
        }
      },
      "comment": "The sole `%@` is the game title. This is the introductory body text on the save-conflict comparison screen."
    },
    "You played on %@ and %@ while they were out of sync. Choose which progress to keep.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu as joué sur %@ et %@ sans qu’ils soient synchronisés. Choisis la progression à garder."
