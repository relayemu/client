    "Your online storage has been removed. Your local games and saves have not been deleted.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your online storage has been removed. Your local games and saves have not been deleted."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton stockage en ligne a été supprimé. Tes jeux et sauvegardes sur cet appareil ont été conservés."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu almacenamiento en línea se ha eliminado. Tus juegos y guardados locales no se han borrado."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Onlinespeicher wurde entfernt. Deine lokalen Spiele und Speicherstände wurden nicht gelöscht."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "온라인 저장 공간이 삭제되었습니다. 이 기기의 게임과 세이브는 삭제되지 않았습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je onlineopslag is verwijderd. Je lokale games en opslagpunten zijn niet verwijderd."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditt lagringsutrymme online har tagits bort. Dina lokala spel och sparningar har inte raderats."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo spazio online è stato rimosso. I giochi e i salvataggi locali non sono stati eliminati."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu armazenamento online foi removido. Seus jogos e salvamentos locais não foram apagados."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminó tu almacenamiento en línea. No se eliminaron los juegos ni los guardados de este dispositivo."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dane przechowywane online zostały usunięte. Lokalne gry i zapisy nie zostały usunięte."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Spațiul tău de stocare online a fost eliminat. Jocurile și salvările de pe dispozitivul tău nu au fost șterse."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンラインストレージは削除されました。ローカルのゲームとセーブは削除されていません。"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O teu armazenamento online foi removido. Os teus jogos e pontos guardados locais não foram eliminados."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的線上儲存空間已移除。本機遊戲和存檔並未刪除。"
          }
        }
      }
    },
    "Your online storage is being removed. The games and saves on this device stay yours.": {
      "localizations": {
