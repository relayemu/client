    "Your last save didn't go through.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sauvegarde impossible."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t save your progress."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido guardar tu progreso."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Fortschritt konnte nicht gespeichert werden."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "진행 상황을 저장하지 못했습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je voortgang kon niet worden opgeslagen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det gick inte att spara dina framsteg."
          }
        },
