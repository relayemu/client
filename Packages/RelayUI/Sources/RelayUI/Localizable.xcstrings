    "Transfer interrupted. Games already added are safe. Try again to send the remaining files.": {
      "extractionState": "manual",
      "comment": "Relay Transfer: foreground computer-to-app import. Files stay peer-to-peer; account pairing needs no Sync membership.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Transfer interrupted. Games already added are safe. Try again to send the remaining files."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le transfert a été interrompu. Les jeux déjà ajoutés sont conservés. Réessaie pour envoyer les fichiers restants."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Transfer wurde unterbrochen. Bereits hinzugefügte Spiele bleiben erhalten. Versuche es erneut, um die übrigen Dateien zu senden."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "La transferencia se ha interrumpido. Los juegos ya añadidos se conservan. Inténtalo de nuevo para enviar los archivos restantes."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "La transferencia se interrumpió. Los juegos que ya agregaste se conservan. Inténtalo de nuevo para enviar los archivos restantes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il trasferimento è stato interrotto. I giochi già aggiunti sono conservati. Riprova per inviare i file rimanenti."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De overdracht is onderbroken. Games die al zijn toegevoegd, blijven bewaard. Probeer het opnieuw om de overige bestanden te sturen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Transfer został przerwany. Dodane gry pozostają bezpieczne. Spróbuj ponownie, aby wysłać pozostałe pliki."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A transferência foi interrompida. Os jogos já adicionados ficam guardados. Tenta novamente para enviar os ficheiros restantes."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A transferência foi interrompida. Os jogos já adicionados ficam salvos. Tente novamente para enviar os arquivos restantes."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Överföringen avbröts. Spel som redan har lagts till finns kvar. Försök igen för att skicka resten av filerna."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Transferul a fost întrerupt. Jocurile deja adăugate sunt păstrate. Încearcă din nou pentru a trimite fișierele rămase."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "転送が中断されました。追加済みのゲームは保存されています。残りのファイルを送信するには、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전송이 중단되었어요. 이미 추가한 게임은 보관되어 있어요. 나머지 파일을 보내려면 다시 시도하세요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "傳輸已中斷。已加入的遊戲仍會保留。請再試一次以傳送其餘檔案。"
          }
        }
      }
    },
