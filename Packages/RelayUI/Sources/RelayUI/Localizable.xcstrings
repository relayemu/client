    "Restart the game to use achievements safely.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restart the game to use achievements safely."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Redémarre le jeu pour réactiver les succès."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Reinicia el juego para usar los logros de forma segura."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Starte das Spiel neu, um Erfolge sicher zu aktivieren."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "도전 과제를 안전하게 사용하려면 게임을 다시 시작하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
