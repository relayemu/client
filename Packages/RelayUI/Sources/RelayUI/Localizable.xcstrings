          "stringUnit": {
            "state": "translated",
            "value": "請在 iPhone、iPad 或 Mac 上加入你的遊戲。"
          }
        }
      }
    },
    "Add games on your iPhone, iPad, or Mac. With iCloud on, they show up here on their own.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute tes jeux sur ton iPhone, ton iPad ou ton Mac. Active iCloud pour retrouver ta bibliothèque ici."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add games on your iPhone, iPad or Mac. Turn on iCloud to see your library here."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade juegos en tu iPhone, iPad o Mac. Activa iCloud para ver aquí tu biblioteca."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge Spiele auf deinem iPhone, iPad oder Mac hinzu. Aktiviere iCloud, um deine Mediathek hier zu sehen."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone, iPad 또는 Mac에서 게임을 추가하세요. 여기서 라이브러리를 보려면 iCloud를 켜세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg games toe op je iPhone, iPad of Mac. Schakel iCloud in om je bibliotheek hier te zien."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lägg till spel på din iPhone, iPad eller Mac. Slå på iCloud för att se ditt bibliotek här."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi giochi sul tuo iPhone, iPad o Mac. Attiva iCloud per vedere la tua libreria qui."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione jogos no seu iPhone, iPad ou Mac. Ative o iCloud para ver sua biblioteca aqui."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Agrega juegos en tu iPhone, iPad o Mac. Activa iCloud para ver aquí tu biblioteca."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj gry na iPhonie, iPadzie lub Macu. Włącz iCloud, aby zobaczyć tutaj swoją bibliotekę."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Adaugă jocuri pe iPhone, iPad sau Mac. Activează iCloud ca să-ți vezi biblioteca aici."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone、iPad、Macでゲームを追加してください。iCloudをオンにすると、ここにライブラリが表示されます。"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Adiciona jogos no teu iPhone, iPad ou Mac. Ativa o iCloud para veres aqui a tua biblioteca."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在 iPhone、iPad 或 Mac 上加入遊戲。開啟 iCloud 後，即可在這裡看到你的遊戲庫。"
          }
        }
      }
    },
    "Add slow motion, 3×, 4× and Max when the active core supports them.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Joue au ralenti ou à vitesse 3×, 4× et Max dans les jeux compatibles."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Play in slow motion or at 3×, 4× and Max speed in supported games."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Juega a cámara lenta o a velocidad 3×, 4× y Máx. en los juegos compatibles."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spiele unterstützte Spiele in Zeitlupe oder mit 3×, 4× und maximaler Geschwindigkeit."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지원되는 게임에서는 슬로 모션이나 3×, 4× 및 최대 속도로 플레이할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Speel ondersteunde games vertraagd of op 3×, 4× en Max."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Spela långsammare eller med hastigheten 3×, 4× eller Max i spel som stöds."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gioca al rallentatore o alla velocità 3×, 4× e massima nei giochi supportati."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Jogue em câmera lenta ou a 3×, 4× e velocidade máxima nos jogos compatíveis."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Juega en cámara lenta o a 3×, 4× y velocidad máxima en juegos compatibles."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W obsługiwanych grach możesz grać w zwolnionym tempie albo z prędkością 3×, 4× lub Max."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Joacă cu încetinitorul sau la viteze de 3×, 4× și Max în jocurile compatibile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "対応ゲームをスローモーション、3倍速、4倍速、最高速度でプレイできます。"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Joga em câmara lenta ou às velocidades 3×, 4× e Max nos jogos compatíveis."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在支援的遊戲中，以慢動作或 3×、4× 和 Max 速度遊玩。"
          }
        }
      }
    },
    "Add the game files you own from the Files app, by AirDrop, or straight from another app. Relay recognises each one and finds the cover.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Importe tes fichiers de jeu depuis Fichiers, AirDrop ou une autre app."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Import your game files from Files, AirDrop or another app."
          }
        },
        "es-ES": {
