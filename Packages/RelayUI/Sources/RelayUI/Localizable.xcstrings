    "Gameplay Clips include game audio at normal speed. Microphone audio is never included.": {
      "comment": "Recording privacy boundary: Relay captures eligible game audio only and never includes microphone audio.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gameplay Clips include game audio at normal speed. Microphone audio is never included."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les clips de jeu incluent le son du jeu à vitesse normale. Le son du microphone n’est jamais inclus."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Los clips de juego incluyen el audio del juego a velocidad normal. Nunca se incluye el audio del micrófono."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gameplay-Clips enthalten den Spielton bei normaler Geschwindigkeit. Mikrofonton wird nie aufgenommen."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "게임플레이 클립에는 정상 속도의 게임 오디오가 포함됩니다. 마이크 오디오는 절대 포함되지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gameplayclips bevatten gamegeluid op normale snelheid. Microfoongeluid wordt nooit opgenomen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Spelklipp innehåller spelljud i normal hastighet. Mikrofonljud tas aldrig med."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le clip di gioco includono l’audio del gioco a velocità normale. L’audio del microfono non viene mai incluso."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os clipes de gameplay incluem o áudio do jogo na velocidade normal. O áudio do microfone nunca é incluído."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Los clips de partida incluyen el audio del juego a velocidad normal. El audio del micrófono nunca se incluye."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klipy z rozgrywki zawierają dźwięk gry odtwarzany z normalną prędkością. Nagrania nigdy nie zawierają dźwięku z mikrofonu."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Clipurile de joc includ sunetul jocului la viteză normală. Sunetul microfonului nu este inclus niciodată."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゲームプレイクリップには通常速度のゲーム音声が含まれます。マイク音声は一切含まれません。"
