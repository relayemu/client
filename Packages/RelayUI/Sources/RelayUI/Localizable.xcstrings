      "comment": "The sole `%@` is the game title. This is the headline of a download-verification failure message."
    },
    "The downloaded file doesn't match the game. Nothing on %@ was changed.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Import another copy of the game file. Nothing on %@ was changed."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Importe une autre copie du fichier de jeu. Rien n’a été modifié sur %@."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Importa otra copia del archivo de juego. No se ha modificado nada en %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Importiere eine andere Kopie der Spieldatei. Auf %@ wurde nichts geändert."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "게임 파일의 다른 사본을 가져오세요. %@에서는 아무것도 변경되지 않았습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Importeer een andere kopie van het gamebestand. Er is niets op %@ gewijzigd."
          }
        },
        "sv": {
