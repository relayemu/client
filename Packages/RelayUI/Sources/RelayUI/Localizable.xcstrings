    "Relay can't read your library.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’ouvrir ta bibliothèque."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t open your library."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido abrir tu biblioteca."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Mediathek konnte nicht geöffnet werden."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "라이브러리를 열지 못했습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je bibliotheek kon niet worden geopend."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det gick inte att öppna biblioteket."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile aprire la tua libreria."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível abrir sua biblioteca."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo abrir tu biblioteca."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się otworzyć biblioteki."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Biblioteca ta nu a putut fi deschisă."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライブラリを開けませんでした。"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
