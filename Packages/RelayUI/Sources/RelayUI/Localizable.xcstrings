            "value": "無法儲存你的進度。"
          }
        }
      }
    },
    "Your last save didn't go through. Relay will try once more on exit.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La dernière sauvegarde a échoué. Relay réessaiera avant de quitter."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido completar el último guardado. Relay lo intentará una vez más al salir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein letzter Speichervorgang ist fehlgeschlagen. Relay versucht es beim Beenden noch einmal."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마지막 세이브를 저장하지 못했습니다. 종료할 때 Relay가 한 번 더 시도합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je voortgang kon niet worden opgeslagen. Relay probeert het bij het afsluiten nog één keer."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din senaste sparning misslyckades. Relay försöker en gång till när du avslutar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’ultimo salvataggio non è stato completato. Relay riproverà all’uscita."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu último salvamento não foi concluído. O Relay tentará mais uma vez ao sair."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo guardar tu progreso. Relay lo intentará una vez más al salir."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się wykonać ostatniego zapisu. Relay spróbuje jeszcze raz podczas wychodzenia."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ultima salvare a eșuat. Relay va mai încerca o dată la ieșire."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最後のセーブに失敗しました。終了時にRelayがもう一度試します。"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível criar o teu último ponto guardado. O Relay tentará novamente ao sair."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "上次儲存未成功。Relay 會在結束遊戲時再試一次。"
          }
        }
      }
    },
    "Your library and saves stay available. Get Relay Pro to start or continue %@ in the native Mac app.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay Pro is needed to play %@ on Mac. Your library and saves are still available."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay Pro est nécessaire pour jouer à %@ sur Mac. Ta bibliothèque et tes sauvegardes restent disponibles."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Se necesita Relay Pro para jugar a %@ en Mac. Tu biblioteca y tus guardados siguen disponibles."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay Pro ist erforderlich, um %@ auf dem Mac zu spielen. Deine Mediathek und Speicherstände sind weiter verfügbar."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac에서 %@ 게임을 플레이하려면 Relay Pro가 필요합니다. 라이브러리와 세이브는 계속 이용할 수 있습니다."
          }
