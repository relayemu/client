    "This image can't be used as a cover.": {
      "comment": "Alert title after the player chose a file or photo Relay cannot read as an image, or one that is far too large.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This image can’t be used as a cover."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette image ne peut pas servir de jaquette."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Bild kann nicht als Cover verwendet werden."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta imagen no se puede usar como portada."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta imagen no se puede usar como portada."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa immagine non può essere usata come copertina."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この画像はカバーアートとして使用できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 이미지는 커버 이미지로 사용할 수 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze afbeelding kan niet als cover worden gebruikt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tego obrazu nie można użyć jako okładki."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta imagem não pode ser usada como capa."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta imagem não pode ser usada como capa."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Această imagine nu poate fi folosită drept copertă."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här bilden kan inte användas som omslag."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此影像無法用作封面。"
          }
        }
      }
    },
    "Try another photo or image file.": {
      "comment": "Alert message under “This image can't be used as a cover.”: what the player can do next.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try another photo or image file."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Essaie une autre photo ou un autre fichier image."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Probier ein anderes Foto oder eine andere Bilddatei."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Prueba con otra foto u otro archivo de imagen."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Intenta con otra foto u otro archivo de imagen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prova con un’altra foto o un altro file immagine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別の写真または画像ファイルを試してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 사진이나 이미지 파일을 사용해 보세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Probeer een andere foto of een ander afbeeldingsbestand."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spróbuj innego zdjęcia lub innego pliku obrazu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tente outra foto ou outro arquivo de imagem."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Experimenta outra fotografia ou outro ficheiro de imagem."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Încearcă altă fotografie sau alt fișier imagine."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Prova ett annat foto eller en annan bildfil."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請試試其他照片或影像檔案。"
          }
        }
      }
    },
