    "Every component distributed in Relay %@, with its exact version and licence. Relay's own code is %@.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque composant distribué dans Relay %1$@, avec sa version exacte et sa licence. Le code de Relay est sous %2$@."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los componentes distribuidos en Relay %1$@, con su versión y licencia exactas. El código propio de Relay es %2$@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede mit Relay %@ ausgelieferte Komponente mit ihrer genauen Version und Lizenz. Relays eigener Code ist %@."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay %@에 포함된 모든 구성 요소의 정확한 버전과 라이선스입니다. Relay 자체 코드는 %@입니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elk onderdeel dat in Relay %@ wordt verspreid, met de exacte versie en licentie. De eigen code van Relay is %@."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Alla komponenter som ingår i Relay %@, med exakt version och licens. Relays egen kod är %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni componente distribuito in Relay %@, con versione e licenza esatte. Il codice di Relay è %@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada componente distribuído no Relay %@, com sua versão e licença exatas. O código do próprio Relay é %@."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada componente distribuido en Relay %@, con su versión y licencia exactas. El código propio de Relay es %@."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każdy komponent dystrybuowany w Relay %@ wraz z dokładną wersją i licencją. Kod samego Relay jest %@."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fiecare componentă distribuită în Relay %@, cu versiunea și licența exactă. Codul propriu al aplicației Relay este %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay %@に含まれる全コンポーネントと、その正確なバージョンおよびライセンスです。Relay独自のコードは%@です。"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os componentes distribuídos no Relay %@, com a versão e a licença exatas. O código do próprio Relay é %@."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay %@ 內散布的每個元件，以及各自的確切版本與授權。Relay 自有程式碼採用 %@。"
          }
        }
      },
      "comment": "Introduction on the Open Source & Licenses screen. The first placeholder is Relay's version string; the second is Relay's licence identifier. Preserve their identities when reordering."
    },
