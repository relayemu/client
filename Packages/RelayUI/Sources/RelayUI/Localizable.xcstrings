    "Sign in to your Relay account before continuing.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connecte-toi à ton compte Relay pour continuer."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sesión en tu Cuenta Relay para continuar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melde dich bei deinem Relay Account an, bevor du fortfährst."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계속하기 전에 Relay Account에 로그인하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Log in bij je Relay Account voordat je doorgaat."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Logga in på ditt Relay-konto innan du fortsätter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accedi al tuo Relay Account prima di continuare."
          }
        },
        "pt-BR": {
