      "comment": "Placeholder 1 `%@` is the game title; placeholder 2 `%@` is an already-localized current-device noun phrase such as “this iPhone” or “this Mac”. This is the body of the continuity message shown when progress is present but the game file is not on the current device; preserve the title-then-device identity if reordered."
    },
    "Your purchase is pending approval.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton achat attend une approbation."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu compra está pendiente de aprobación."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Kauf wartet auf Genehmigung."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구매 승인 대기 중입니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je aankoop wacht op goedkeuring."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditt köp väntar på godkännande."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo acquisto è in attesa di approvazione."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua compra está aguardando aprovação."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu compra está pendiente de aprobación."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twój zakup oczekuje na zatwierdzenie."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Achiziția ta așteaptă aprobarea."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "購入は承認待ちです。"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A tua compra aguarda aprovação."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的購買項目正在等待核准。"
          }
        }
      }
    },
    "Your purchase is pending approval. Your current plan stays unchanged until Apple approves it.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton achat attend une approbation. Ta formule actuelle reste inchangée jusqu’à sa validation par Apple."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu compra está pendiente de aprobación. Tu plan actual no cambiará hasta que Apple la apruebe."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Kauf wartet auf Genehmigung. Dein aktueller Tarif bleibt unverändert, bis Apple ihn genehmigt."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구매 승인 대기 중입니다. Apple이 승인할 때까지 현재 요금제는 변경되지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je aankoop wacht op goedkeuring. Je huidige formule blijft ongewijzigd totdat Apple de aankoop goedkeurt."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditt köp väntar på godkännande. Din nuvarande plan ändras inte förrän Apple godkänner köpet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo acquisto è in attesa di approvazione. Il tuo piano attuale rimane invariato finché Apple non lo approva."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua compra está aguardando aprovação. Seu plano atual não será alterado até a Apple aprová-la."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu compra está pendiente de aprobación. Tu plan actual permanece sin cambios hasta que Apple la apruebe."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twój zakup oczekuje na zatwierdzenie. Obecny plan pozostanie bez zmian, dopóki Apple go nie zatwierdzi."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Achiziția ta așteaptă aprobarea. Planul tău actual nu se schimbă până când Apple o aprobă."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "購入は承認待ちです。Appleが承認するまで現在のプランは変更されません。"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A tua compra aguarda aprovação. O teu plano atual mantém-se até a Apple a aprovar."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的購買項目正在等待核准。在 Apple 核准前，你目前的方案不會變更。"
          }
        }
      }
    },
    "Your saves are safe on %@ but haven't synced yet.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes sauvegardes sont en sécurité sur %@ mais ne sont pas encore synchronisées."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus guardados están a salvo en %@, pero aún no se han sincronizado."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Speicherstände sind auf %@ sicher, wurden aber noch nicht synchronisiert."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세이브는 %@에 안전하게 보관되어 있지만 아직 동기화되지 않았습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je opslagpunten zijn veilig op %@, maar nog niet gesynchroniseerd."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dina sparningar finns kvar på %@ men har inte synkroniserats än."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I salvataggi sono al sicuro su %@, ma non sono ancora sincronizzati."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus salvamentos estão seguros em %@, mas ainda não foram sincronizados."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus guardados están seguros en %@, pero aún no se han sincronizado."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisy są bezpieczne, ale nie zostały jeszcze zsynchronizowane. Urządzenie: %@."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvările tale sunt în siguranță pe %@, dar nu s-au sincronizat încă."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セーブは%@に残っていますが、まだ同期されていません。"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os teus pontos guardados estão seguros em %@, mas ainda não foram sincronizados."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的存檔仍安全地保留在 %@，但尚未同步。"
          }
        }
      },
      "comment": "The sole `%@` is an already-localized current-device noun phrase such as “this iPhone” or “this Mac”. This is the body of the iCloud or Relay Sync quota-full message."
    },
    "Your session has expired. Sign in with Apple again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your session has expired. Sign in with Apple again."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta session a expiré. Connecte-toi à nouveau avec Apple."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu sesión ha caducado. Vuelve a iniciar sesión con Apple."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Sitzung ist abgelaufen. Melde dich erneut mit Apple an."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세션이 만료되었습니다. Apple로 다시 로그인하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je sessie is verlopen. Log opnieuw in met Apple."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din session har gått ut. Logga in med Apple igen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua sessione è scaduta. Accedi nuovamente con Apple."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua sessão expirou. Entre novamente com a Apple."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu sesión venció. Vuelve a iniciar sesión con Apple."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesja wygasła. Zaloguj się ponownie przez Apple."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesiunea ta a expirat. Autentifică-te din nou cu Apple."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セッションの有効期限が切れました。もう一度Appleでサインインしてください。"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A tua sessão expirou. Volta a iniciar sessão com a Apple."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的工作階段已過期。請再次使用 Apple 登入。"
          }
        }
      }
    },
    "Your verified Pro Once loyalty storage is included.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton bonus de stockage de l’achat unique Pro est inclus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Includes your Pro Once storage bonus."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Incluye tu espacio adicional de Pro con pago único."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Speicherbonus aus dem Pro-Einmalkauf ist enthalten."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro 일회성 구매 저장 공간 보너스가 포함됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Inclusief je opslagbonus van de eenmalige Pro-aankoop."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inkluderar din lagringsbonus från engångsköpet av Relay Pro."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Include il bonus di spazio dell’acquisto unico Pro."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Inclui seu bônus de armazenamento da compra única do Pro."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Incluye tu bono de almacenamiento de Pro con pago único."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Obejmuje dodatkowe miejsce z jednorazowego zakupu Pro."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Include bonusul tău de stocare pentru achiziția unică Pro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro買い切りのストレージボーナスを含みます。"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Inclui o teu bónus de armazenamento da compra única do Pro."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "包含你的 Pro 一次買斷儲存空間加碼。"
          }
        }
      }
    },
    "ZIP archives with game files inside work too. A game whose progress arrived from another device becomes playable as soon as you add its file here. More systems arrive in later versions.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu peux aussi importer des fichiers ZIP. Pour continuer un jeu commencé sur un autre appareil, ajoute son fichier ici."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can also import ZIP files. To continue a game from another device, add its game file here."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "También puedes importar archivos ZIP. Para continuar un juego desde otro dispositivo, añade aquí su archivo de juego."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst auch ZIP-Dateien importieren. Füge die Spieldatei eines Spiels von einem anderen Gerät hier hinzu, um es fortzusetzen."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "ZIP 파일도 가져올 수 있습니다. 다른 기기에서 플레이하던 게임을 이어하려면 여기에 해당 게임 파일을 추가하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt ook ZIP-bestanden importeren. Voeg hier het gamebestand toe om verder te gaan waar je op een ander apparaat was gebleven."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan även importera ZIP-filer. Lägg till spelfilen här för att fortsätta ett spel från en annan enhet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi anche importare file ZIP. Per continuare un gioco da un altro dispositivo, aggiungi qui il file di gioco."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você também pode importar arquivos ZIP. Para continuar um jogo de outro dispositivo, adicione seu arquivo de jogo aqui."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "También puedes importar archivos ZIP. Para continuar un juego de otro dispositivo, agrega aquí su archivo de juego."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Możesz również importować pliki ZIP. Aby kontynuować grę z innego urządzenia, dodaj tutaj jej plik."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Poți importa și fișiere ZIP. Ca să continui un joc de pe alt dispozitiv, adaugă aici fișierul jocului."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ZIPファイルも読み込めます。別のデバイスからゲームを続けるには、ここにゲームファイルを追加してください。"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Também podes importar ficheiros ZIP. Para continuares um jogo de outro dispositivo, adiciona aqui o respetivo ficheiro de jogo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你也可以匯入 ZIP 檔案。若要繼續另一部裝置上的遊戲，請在這裡加入該遊戲檔案。"
          }
        }
      }
    },
    "ZIP archives with game files inside work too. More systems arrive in later versions.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu peux aussi importer des fichiers ZIP contenant des jeux."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can also import ZIP files containing games."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "También puedes importar archivos ZIP que contengan juegos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst auch ZIP-Dateien mit Spielen importieren."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "게임이 들어 있는 ZIP 파일도 가져올 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt ook ZIP-bestanden met games importeren."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan även importera ZIP-filer som innehåller spel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi anche importare file ZIP contenenti giochi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você também pode importar arquivos ZIP contendo jogos."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "También puedes importar archivos ZIP que contengan juegos."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Możesz również importować pliki ZIP zawierające gry."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Poți importa și fișiere ZIP care conțin jocuri."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゲームを含むZIPファイルも読み込めます。"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Também podes importar ficheiros ZIP que contenham jogos."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你也可以匯入包含遊戲的 ZIP 檔案。"
          }
        }
      }
    },
