    "Relay includes no games. Bring the files you own.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay n’inclut aucun jeu. Apporte les fichiers que tu possèdes."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay no incluye juegos. Añade los archivos que poseas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay enthält keine Spiele. Nutze Dateien, die dir gehören."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay에는 게임이 포함되어 있지 않습니다. 본인이 소유한 파일을 가져오세요."
          }
        },
        "nl": {
