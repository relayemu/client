          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione seus jogos em um iPhone, iPad ou Mac."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Agrega tus juegos en un iPhone, iPad o Mac."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj swoje gry na iPhonie, iPadzie lub Macu."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Adaugă jocurile tale pe un iPhone, iPad sau Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone、iPad、Macでゲームを追加してください。"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Adiciona os teus jogos num iPhone, iPad ou Mac."
          }
        },
