        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay Pro è necessario per giocare a %@ su Mac. La tua libreria e i salvataggi sono ancora disponibili."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
