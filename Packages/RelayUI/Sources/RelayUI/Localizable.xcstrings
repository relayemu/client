    "This stops Relay Sync on this device. Your local games and saves and your online library are kept.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sync will stop on this device. Your games and saves are kept here and online."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La synchronisation s’arrêtera sur cet appareil. Tes jeux et sauvegardes seront conservés ici et en ligne."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "La sincronización se detendrá en este dispositivo. Tus juegos y guardados se conservarán aquí y en línea."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Synchronisierung auf diesem Gerät wird beendet. Deine Spiele und Speicherstände bleiben hier und online erhalten."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에서 동기화가 중지됩니다. 게임과 세이브는 이 기기와 온라인에 유지됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronisatie stopt op dit apparaat. Je games en opslagpunten blijven hier en online bewaard."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Synkroniseringen stoppas på den här enheten. Dina spel och sparningar behålls här och online."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La sincronizzazione verrà interrotta su questo dispositivo. I tuoi giochi e i tuoi salvataggi vengono conservati qui e online."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A sincronização será interrompida neste dispositivo. Seus jogos e salvamentos serão mantidos aqui e online."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "La sincronización se detendrá en este dispositivo. Tus juegos y guardados se conservarán aquí y en línea."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronizacja na tym urządzeniu zostanie zatrzymana. Gry i zapisy pozostaną tutaj oraz online."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincronizarea se va opri pe acest dispozitiv. Jocurile și salvările tale sunt păstrate aici și online."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスでは同期が停止します。ゲームとセーブはこのデバイスとオンラインの両方に残ります。"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A sincronização será interrompida neste dispositivo. Os teus jogos e pontos guardados são mantidos aqui e online."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將停止在此裝置上同步。你的遊戲和存檔會保留在這裡和線上。"
          }
        }
      }
    },
