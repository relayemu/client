    "All 12 systems are free on iPhone, iPad and Apple TV. Your library, saves and iCloud sync are free on every device.": {
      "comment": "Commerce promise: all twelve playable systems are Free on iPhone, iPad and Apple TV; the existing native Mac Pro policy is separate.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All 12 systems are free on iPhone, iPad and Apple TV. Your library, saves and iCloud sync are free on every device."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les 12 systèmes sont gratuits sur iPhone, iPad et Apple TV. Ta bibliothèque, tes sauvegardes et la synchronisation iCloud restent gratuites sur tous tes appareils."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Los 12 sistemas son gratuitos en iPhone, iPad y Apple TV. Tu biblioteca, tus guardados y la sincronización con iCloud son gratuitos en todos los dispositivos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle 12 Systeme sind auf iPhone, iPad und Apple TV kostenlos. Deine Mediathek, Speicherstände und iCloud-Synchronisierung sind auf jedem Gerät kostenlos."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "12개 시스템 모두 iPhone, iPad 및 Apple TV에서 무료입니다. 라이브러리, 세이브 및 iCloud 동기화는 모든 기기에서 무료입니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle 12 systemen zijn gratis op iPhone, iPad en Apple TV. Je bibliotheek, opslagpunten en iCloud-synchronisatie zijn gratis op elk apparaat."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Alla 12 system är gratis på iPhone, iPad och Apple TV. Ditt bibliotek, dina sparningar och iCloud-synkronisering är gratis på alla enheter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutti e 12 i sistemi sono gratuiti su iPhone, iPad e Apple TV. La tua libreria, i salvataggi e la sincronizzazione iCloud sono gratuiti su ogni dispositivo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os 12 sistemas são gratuitos no iPhone, iPad e Apple TV. Sua biblioteca, seus salvamentos e a sincronização com o iCloud são gratuitos em todos os dispositivos."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Los 12 sistemas son gratuitos en iPhone, iPad y Apple TV. Tu biblioteca, tus guardados y la sincronización con iCloud son gratuitos en todos tus dispositivos."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystkie 12 systemów jest dostępnych bezpłatnie na iPhonie, iPadzie i Apple TV. Biblioteka, zapisy i synchronizacja przez iCloud są bezpłatne na każdym urządzeniu."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Toate cele 12 sisteme sunt gratuite pe iPhone, iPad și Apple TV. Biblioteca, salvările și sincronizarea prin iCloud sunt gratuite pe fiecare dispozitiv."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone、iPad、Apple TVでは全12システムを無料でプレイできます。ライブラリ、セーブ、iCloud同期はすべてのデバイスで無料です。"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os 12 sistemas são gratuitos no iPhone, iPad e Apple TV. A tua biblioteca, os teus pontos guardados e a sincronização com o iCloud são gratuitos em todos os dispositivos."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone、iPad 和 Apple TV 上的 12 種遊戲系統全部免費。你的遊戲庫、存檔及 iCloud 同步在所有裝置上都免費。"
          }
        }
      }
    },
    "Press both sticks together for Select.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press both sticks together for Select."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuie sur les deux sticks en même temps pour Select."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsa los dos sticks a la vez para Select."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drücke beide Sticks gleichzeitig für Select."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "두 스틱을 동시에 눌러 Select를 입력하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Druk beide sticks tegelijk in voor Select."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck ned båda spakarna samtidigt för Select."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Premi insieme entrambe le levette per Select."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pressione os dois analógicos ao mesmo tempo para Select."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Presiona ambas palancas al mismo tiempo para usar Select."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Naciśnij obie gałki jednocześnie, aby użyć przycisku Select."
          }
        },
        "ro": {
