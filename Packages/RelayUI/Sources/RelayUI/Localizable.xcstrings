    "Choose Once to keep Relay Pro without a monthly renewal.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisis l’achat unique pour garder Relay Pro sans renouvellement mensuel."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige Pago único para conservar Relay Pro sin renovación mensual."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle „Einmalig“, um Relay Pro ohne monatliche Verlängerung zu behalten."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "매달 갱신하지 않고 Relay Pro를 계속 이용하려면 일회성 구매를 선택하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies Eenmalig om Relay Pro te houden zonder maandelijkse verlenging."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj Engångsköp för att behålla Relay Pro utan månadsvis förnyelse."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli Acquisto unico per mantenere Relay Pro senza rinnovo mensile."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha Compra única para manter o Relay Pro sem renovação mensal."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige Pago único para conservar Relay Pro sin renovación mensual."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz opcję Jednorazowo, aby zachować Relay Pro bez comiesięcznego odnawiania."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alege opțiunea O singură dată pentru a păstra Relay Pro fără reînnoire lunară."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "月額更新なしでRelay Proを使い続けるには「買い切り」を選択してください。"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolhe Compra única para manteres o Relay Pro sem renovação mensal."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇「一次買斷」，即可保有 Relay Pro，無須每月續訂。"
          }
        }
      }
    },
    "Choose curated scaling, filters and per-game screen layouts.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisis les filtres, la taille de l’image et la disposition des écrans pour chaque jeu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose filters, picture size and screen layouts for each game."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige los filtros, el tamaño de imagen y la disposición de las pantallas de cada juego."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle für jedes Spiel Filter, Bildgröße und Bildschirmlayout."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "게임별로 필터, 화면 크기 및 화면 배치를 선택하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies voor elke game filters, beeldgrootte en schermindelingen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj filter, bildstorlek och skärmlayout för varje spel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli filtri, dimensioni dell’immagine e layout dello schermo per ogni gioco."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha filtros, tamanho da imagem e layouts de tela para cada jogo."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige filtros, tamaño de imagen y diseños de pantalla para cada juego."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz filtry, rozmiar obrazu i układ ekranów osobno dla każdej gry."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alege filtre, dimensiunea imaginii și aspectul ecranului pentru fiecare joc."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゲームごとにフィルター、画面サイズ、画面レイアウトを選択できます。"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolhe filtros, o tamanho da imagem e a disposição dos ecrãs para cada jogo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為每個遊戲選擇濾鏡、畫面大小和螢幕配置。"
          }
        }
      }
    },
    "Choose one service for automatic sync. Switching keeps your local library and the previous service's data. Different save versions stay available for you to choose.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changing services keeps your games and saves on this device. Your files stay in the previous service too."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Changer de service conserve tes jeux et sauvegardes sur cet appareil. Tes fichiers restent aussi dans le service précédent."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Al cambiar de servicio, los juegos y guardados se conservan en este dispositivo. Tus archivos también permanecen en el servicio anterior."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Dienstwechsel bleiben deine Spiele und Speicherstände auf diesem Gerät. Deine Dateien bleiben auch beim bisherigen Dienst."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서비스를 바꿔도 이 기기의 게임과 세이브는 유지됩니다. 이전 서비스에도 파일이 남아 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als je van service wisselt, blijven je games en opslagpunten op dit apparaat staan. Je bestanden blijven ook in de vorige service."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "När du byter tjänst behålls spelen och sparningarna på den här enheten. Dina filer finns även kvar i den tidigare tjänsten."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se cambi servizio, i giochi e i salvataggi restano su questo dispositivo. I file restano anche nel servizio precedente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao mudar de serviço, seus jogos e salvamentos permanecem neste dispositivo. Seus arquivos também permanecem no serviço anterior."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Al cambiar de servicio, tus juegos y guardados permanecen en este dispositivo. Tus archivos también se quedan en el servicio anterior."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmiana usługi nie usuwa gier ani zapisów z tego urządzenia. Twoje pliki pozostaną również w poprzedniej usłudze."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Schimbarea serviciilor păstrează jocurile și salvările tale pe acest dispozitiv. Fișierele rămân și în serviciul anterior."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サービスを変更しても、このデバイスのゲームとセーブは残ります。以前のサービスにもファイルが残ります。"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Mudar de serviço mantém os teus jogos e pontos guardados neste dispositivo. Os teus ficheiros também permanecem no serviço anterior."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "更換服務後，這部裝置上的遊戲和存檔會保留。你的檔案也會留在先前的服務中。"
          }
        }
      }
    },
    "Choose this control, then move or resize it.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisis cette commande, puis déplace-la ou redimensionne-la."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige este control y muévelo o cambia su tamaño."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle dieses Steuerelement aus. Dann kannst du es verschieben oder seine Größe ändern."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 컨트롤을 선택한 다음 이동하거나 크기를 조절하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecteer dit bedieningselement en verplaats het of wijzig de grootte."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj det här reglaget och flytta eller ändra storlek på det."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli questo controllo, quindi spostalo o ridimensionalo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha este controle e mova-o ou redimensione-o."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige este control y luego muévelo o cambia su tamaño."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz ten element sterowania, a następnie go przesuń lub zmień jego rozmiar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alege această comandă, apoi mut-o sau redimensioneaz-o."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このコントロールを選択して、移動またはサイズ変更してください。"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolhe este comando e depois move-o ou redimensiona-o."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選取此控制項，再移動或調整大小。"
          }
        }
      }
    },
    "Choose what each physical button does. Menu and Home always keep Relay navigation safe.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisis l’action de chaque bouton de la manette. Menu et Accueil gardent leur fonction habituelle."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose what each controller button does. Menu and Home keep their usual actions."
          }
