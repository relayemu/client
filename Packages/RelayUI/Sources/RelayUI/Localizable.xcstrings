    "Play this game to discover its achievements.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Play this game to discover its achievements."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Joue à ce jeu pour découvrir ses succès."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Juega para descubrir los logros de este juego."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spiele dieses Spiel, um seine Erfolge zu entdecken."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 게임을 플레이하여 도전 과제를 찾아보세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Speel deze game om de prestaties te ontdekken."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Spela det här spelet för att upptäcka dess prestationer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gioca a questo gioco per scoprirne gli obiettivi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Jogue para descobrir as conquistas disponíveis neste jogo."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Juega este juego para descubrir sus logros."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zagraj w tę grę, aby odkryć jej osiągnięcia."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Joacă acest joc pentru a-i descoperi realizările."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
