            "value": "Puede que se haya eliminado. Impórtalo de nuevo para jugar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie wurde möglicherweise gelöscht. Importiere sie erneut, um zu spielen."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "삭제되었을 수 있습니다. 다시 가져와서 플레이하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het is mogelijk verwijderd. Importeer het opnieuw om te spelen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den kan ha raderats. Importera den igen för att spela."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Potrebbe essere stato eliminato. Importalo di nuovo per giocare."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Talvez ele tenha sido apagado. Importe-o novamente para jogar."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Es posible que se haya eliminado. Vuelve a importarlo para jugar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Być może został usunięty. Zaimportuj go ponownie, aby zagrać."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Este posibil să fi fost șters. Importă-l din nou pentru a juca."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除された可能性があります。プレイするにはもう一度読み込んでください。"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Pode ter sido eliminado. Volta a importá-lo para jogar."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可能已被刪除。請重新匯入以繼續遊玩。"
          }
        }
      }
    },
    "It picks up when you're back online.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifie ta connexion, puis relance le téléchargement."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check your connection, then try the download again."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba tu conexión y vuelve a intentar la descarga."
          }
        },
