      "comment": "The sole `%@` is an already-localized current-device noun phrase such as “this iPhone” or “this Mac”. This is the consequence text in destructive delete confirmations from both Game Detail and Library."
    },
    "Removing a download keeps the game in iCloud. Your saves stay on %@.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer un téléchargement garde le jeu dans iCloud. Tes sauvegardes restent sur %@."
          }
        }
      }
    },
    "Removing a download keeps the game in your selected sync service. Your saves stay on %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Removing a download keeps the game in your selected sync service. Your saves stay on %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer le téléchargement conserve le jeu dans ton service de synchronisation. Tes sauvegardes restent sur %@."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Al eliminar la descarga, el juego se conserva en el servicio de sincronización seleccionado. Tus guardados permanecen en %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du den Download entfernst, bleibt das Spiel im gewählten Synchronisierungsdienst. Deine Speicherstände bleiben auf %@."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다운로드를 제거해도 선택한 동기화 서비스에는 게임이 유지됩니다. 세이브는 %@에 남아 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als je een download verwijdert, blijft de game in de gekozen synchronisatieservice. Je opslagpunten blijven op %@."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Om du tar bort den hämtade filen ligger spelet kvar i den valda synkroniseringstjänsten. Dina sparningar finns kvar på %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La rimozione di un download mantiene il gioco nel servizio di sincronizzazione selezionato. I tuoi salvataggi rimangono su %@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Remover um download mantém o jogo no serviço de sincronização selecionado. Seus salvamentos permanecem em %@."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Al eliminar una descarga, el juego permanece en el servicio de sincronización seleccionado. Tus guardados permanecen en %@."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usunięcie pobranej kopii pozostawia grę w wybranej usłudze synchronizacji. Zapisy pozostaną na tym urządzeniu: %@."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminarea descărcării păstrează jocul în serviciul de sincronizare selectat. Salvările tale rămân pe %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダウンロードを削除しても、選択中の同期サービスにはゲームが残ります。セーブは%@に残ります。"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Remover uma descarga mantém o jogo no serviço de sincronização selecionado. Os teus pontos guardados permanecem em %@."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "移除下載項目後，遊戲仍會保留在所選的同步服務中。你的存檔會留在 %@ 上。"
          }
        }
      },
      "comment": "The sole `%@` is an already-localized current-device noun phrase such as “this iPhone” or “this Mac”. This is the consequence text in the Remove Download confirmation on Game Detail."
    },
    "Renews monthly until cancelled.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Renouvelé chaque mois jusqu’à résiliation."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Se renueva cada mes hasta que se cancele."
          }
        },
        "de": {
