    "Systems appear here once you add games.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les systèmes apparaissent ici dès que tu ajoutes des jeux."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Los sistemas aparecerán aquí cuando añadas juegos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Systeme erscheinen hier, sobald du Spiele hinzufügst."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
