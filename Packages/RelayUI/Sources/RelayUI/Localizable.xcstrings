    },
    "A different Relay account is connected. Choose whether to sync this library with it.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A different Relay account is connected. Choose whether to sync this library with it."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un autre compte Relay est connecté. Choisis si tu veux y synchroniser cette bibliothèque."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay otra Cuenta Relay conectada. Elige si quieres sincronizar esta biblioteca con ella."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein anderer Relay Account ist verbunden. Wähle, ob diese Mediathek damit synchronisiert werden soll."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 Relay Account가 연결되어 있습니다. 이 계정과 현재 라이브러리를 동기화할지 선택하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is een ander Relay Account gekoppeld. Kies of je deze bibliotheek ermee wilt synchroniseren."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett annat Relay-konto är anslutet. Välj om biblioteket ska synkroniseras med det."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È connesso un Relay Account diverso. Scegli se sincronizzare questa libreria con quell’account."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Outra Relay Account está conectada. Escolha se deseja sincronizar esta biblioteca com ela."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay otra Cuenta Relay conectada. Elige si quieres sincronizar esta biblioteca con ella."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Połączono z innym Kontem Relay. Wybierz, czy chcesz zsynchronizować z nim tę bibliotekę."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Este conectat un alt Relay Account. Alege dacă vrei să sincronizezi această bibliotecă cu el."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別のRelay Accountが接続されています。このライブラリを同期するか選択してください。"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Está ligada uma Relay Account diferente. Escolhe se queres sincronizar esta biblioteca com essa conta."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前連結的是另一個 Relay 帳號。請選擇是否要使用該帳號同步此遊戲庫。"
          }
        }
      }
    },
