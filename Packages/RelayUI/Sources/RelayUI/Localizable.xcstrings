    "Check the spelling, or add the game from another device.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifie l’orthographe, ou ajoute le jeu depuis un autre appareil."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba la ortografía o añade el juego desde otro dispositivo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfe die Schreibweise oder füge das Spiel von einem anderen Gerät hinzu."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "철자를 확인하거나 다른 기기에서 게임을 추가하세요."
          }
        },
        "nl": {
