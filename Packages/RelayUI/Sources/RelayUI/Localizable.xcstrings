    "Using emulated system software. Add PlayStation firmware in Settings for better compatibility.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Using emulated system software. Add PlayStation firmware in Settings for better compatibility."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Logiciel système émulé en cours d’utilisation. Ajoute le firmware PlayStation dans Réglages pour une meilleure compatibilité."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Se está usando software de sistema emulado. Añade firmware de PlayStation en Ajustes para mejorar la compatibilidad."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Emulierte Systemsoftware wird verwendet. Füge in den Einstellungen PlayStation-Firmware hinzu, um die Kompatibilität zu verbessern."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에뮬레이션된 시스템 소프트웨어를 사용 중입니다. 호환성을 높이려면 설정에서 PlayStation 펌웨어를 추가하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geëmuleerde systeemsoftware wordt gebruikt. Voeg PlayStation-firmware toe in Instellingen voor betere compatibiliteit."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Emulerad systemprogramvara används. Lägg till fast programvara för PlayStation under Inställningar för bättre kompatibilitet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Software di sistema emulato in uso. Aggiungi il firmware PlayStation nelle Impostazioni per migliorare la compatibilità."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usando software de sistema emulado. Adicione o firmware do PlayStation nos Ajustes para melhorar a compatibilidade."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Se está usando software de sistema emulado. Agrega el firmware de PlayStation en Configuración para mejorar la compatibilidad."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay korzysta z emulowanego oprogramowania systemowego. Aby uzyskać lepszą zgodność, dodaj firmware PlayStation w Ustawieniach."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Se folosește software de sistem emulat. Adaugă firmware PlayStation în Configurări pentru compatibilitate mai bună."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エミュレートされたシステムソフトウェアを使用中です。互換性を高めるには「設定」でPlayStationファームウェアを追加してください。"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A utilizar software de sistema emulado. Adiciona firmware PlayStation em Definições para melhorar a compatibilidade."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前使用模擬的系統軟體。請在「設定」中加入 PlayStation 韌體，以提升相容性。"
          }
        }
      }
    },
