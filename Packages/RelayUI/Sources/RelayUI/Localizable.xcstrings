    "We couldn't verify this purchase. No hosted storage was granted. Restore purchases or contact support.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de vérifier ton achat et d’activer le stockage. Restaure tes achats ou contacte l’assistance si le problème persiste."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t verify your purchase or activate storage. Restore Purchases, or contact support if the problem continues."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido verificar tu compra ni activar el almacenamiento. Restaura las compras o contacta con el soporte si el problema continúa."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kauf konnte nicht bestätigt oder Speicher nicht aktiviert werden. Stelle deine Käufe wieder her oder kontaktiere den Support, falls das Problem weiter besteht."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구매를 확인하지 못했거나 저장 공간을 활성화하지 못했습니다. 구매 항목을 복원하거나 문제가 계속되면 지원팀에 문의하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je aankoop kon niet worden geverifieerd en de opslag kon niet worden geactiveerd. Herstel aankopen of neem contact op met support als het probleem aanhoudt."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det gick inte att verifiera köpet eller aktivera lagring. Återskapa köp eller kontakta supporten om problemet kvarstår."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile verificare l’acquisto o attivare lo spazio. Ripristina gli acquisti oppure contatta l’assistenza se il problema persiste."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível verificar sua compra ou ativar o armazenamento. Restaure as compras ou entre em contato com o suporte se o problema continuar."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo verificar tu compra ni activar el almacenamiento. Restaura las compras o comunícate con soporte si el problema continúa."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się zweryfikować zakupu ani przyznać miejsca online. Przywróć zakupy lub skontaktuj się z pomocą techniczną, jeśli problem nadal występuje."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Achiziția nu a putut fi verificată, iar spațiul de stocare nu a putut fi activat. Restaurează achizițiile sau contactează asistența dacă problema persistă."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "購入を確認できず、ストレージを有効化できませんでした。「購入を復元」を実行するか、問題が続く場合はサポートへお問い合わせください。"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível verificar a tua compra nem ativar o armazenamento. Restaura as compras ou contacta o suporte se o problema persistir."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法驗證你的購買項目或啟用儲存空間。請回復購買項目；若問題持續發生，請聯絡支援人員。"
          }
        }
      }
    },
