          "stringUnit": {
            "state": "translated",
            "value": "無法開啟你的遊戲庫。"
          }
        }
      }
    },
    "Relay couldn't load it. A report is ready in Diagnostics.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réessaie. Plus de détails dans Diagnostics."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try again. Diagnostics has more details."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a intentarlo. Encontrarás más información en Diagnóstico."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Versuche es erneut. Die Diagnose enthält weitere Details."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다시 시도하세요. 자세한 내용은 진단에서 확인할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Probeer het opnieuw. Diagnostiek bevat meer informatie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Försök igen. Diagnostik innehåller mer information."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riprova. Trovi maggiori dettagli in Diagnostica."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tente novamente. O Diagnóstico tem mais detalhes."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a intentarlo. Diagnósticos tiene más detalles."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spróbuj ponownie. Więcej informacji znajdziesz w Diagnostyce."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Încearcă din nou. În Diagnosticare găsești mai multe detalii."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "もう一度お試しください。詳細は「診断」で確認できます。"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Tenta novamente. O Diagnóstico contém mais detalhes."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請再試一次。「診斷」中有更多詳細資訊。"
          }
        }
      }
    },
    "Relay couldn't recognise this file.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay n’a pas reconnu ce fichier."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay no ha reconocido este archivo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay konnte diese Datei nicht erkennen."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay가 이 파일을 인식하지 못했습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay kon dit bestand niet herkennen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay kunde inte identifiera filen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay non è riuscito a riconoscere questo file."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Relay não conseguiu reconhecer este arquivo."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay no pudo reconocer este archivo."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay nie rozpoznaje tego pliku."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay nu a putut recunoaște acest fișier."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Relayはこのファイルを認識できませんでした。"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Relay não conseguiu reconhecer este ficheiro."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay 無法辨識此檔案。"
          }
        }
      }
    },
    "Relay couldn't restore it. A report is ready in Diagnostics.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Essaie une autre sauvegarde. Tu trouveras plus de détails dans Diagnostics."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try another save. Diagnostics has more details about this problem."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Prueba con otro guardado. Encontrarás más información sobre el problema en Diagnóstico."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Probiere einen anderen Relay-Speicherstand. Die Diagnose enthält weitere Details zu diesem Problem."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 세이브를 사용해 보세요. 자세한 내용은 진단에서 확인할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Probeer een ander opslagpunt. Diagnostiek bevat meer informatie over dit probleem."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Prova en annan sparning. Diagnostik innehåller mer information om problemet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prova un altro salvataggio. Trovi maggiori dettagli sul problema in Diagnostica."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tente outro salvamento. O Diagnóstico tem mais detalhes sobre este problema."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Prueba con otro guardado. Diagnósticos tiene más detalles sobre este problema."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spróbuj użyć innego zapisu. Więcej informacji o tym problemie znajdziesz w Diagnostyce."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Încearcă o altă salvare. În Diagnosticare găsești mai multe detalii despre această problemă."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別のセーブをお試しください。詳細は「診断」で確認できます。"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Tenta outro ponto guardado. O Diagnóstico contém mais detalhes sobre este problema."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請嘗試其他存檔。「診斷」中有此問題的更多詳細資訊。"
          }
        }
      }
    },
    "Relay couldn't write the save for %@. Your previous save is fine.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de sauvegarder ta progression dans %@. Les sauvegardes déjà créées sont conservées."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t save your progress in %@. Any earlier saves are kept."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido guardar tu progreso en %@. Se conservan los guardados anteriores, si los hay."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Fortschritt in %@ konnte nicht gespeichert werden. Frühere Relay-Speicherstände bleiben erhalten."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에 진행 상황을 저장하지 못했습니다. 이전 세이브는 모두 유지됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je voortgang in %@ kon niet worden opgeslagen. Je eerder opgeslagen voortgang blijft behouden."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det gick inte att spara dina framsteg i %@. Eventuella tidigare sparningar behålls."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile salvare i tuoi progressi in %@. I salvataggi precedenti restano disponibili."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível salvar seu progresso em %@. Seus salvamentos anteriores foram mantidos."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo guardar tu progreso en %@. Los guardados que ya tenías se conservaron."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się zapisać postępów w grze „%@”. Wcześniejsze zapisy zostały zachowane."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Progresul tău nu a putut fi salvat în %@. Salvările anterioare sunt păstrate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@で進行状況を保存できませんでした。以前のセーブは残ります。"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível guardar o teu progresso em %@. Os pontos guardados anteriores são mantidos."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法在「%@」中儲存你的進度。所有較早的存檔都會保留。"
          }
        }
      },
      "comment": "The sole `%@` is the game title. This is the product-message body shown after creation of a quick or manual save fails. Do not infer that an earlier save exists: the first save can fail, so the source key's unconditional “previous save” claim is unsafe; the reviewed catalog values use conditional wording about any earlier saves."
    },
    "Relay creates a manual safety save before the first cheat is enabled in each play session.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay makes a safety save before you first use cheats in each game session."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay crée une sauvegarde de sécurité avant la première utilisation de codes dans chaque partie."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay crea un guardado de seguridad antes de que uses trucos por primera vez en cada partida."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay erstellt vor dem ersten Cheat in jeder Spielsitzung einen Sicherheitsspeicherstand."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay는 각 게임 세션에서 치트를 처음 사용하기 전에 안전 세이브를 만듭니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay maakt een veiligheidsopslagpunt voordat je voor het eerst cheats gebruikt in een gamesessie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay skapar en extra sparning som skydd innan du använder fusk första gången i varje spelsession."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay effettua un salvataggio di sicurezza prima di utilizzare i trucchi per la prima volta in ogni sessione di gioco."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Relay cria um salvamento de segurança antes de você usar trapaças pela primeira vez em cada sessão de jogo."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay crea un guardado de seguridad antes de que uses trucos por primera vez en cada sesión de juego."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay tworzy zapis bezpieczeństwa przed pierwszym użyciem kodów w każdej sesji gry."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay creează o salvare de siguranță înainte să folosești prima dată coduri de trișare în fiecare sesiune de joc."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各ゲームセッションで初めてチートを使う前に、Relayが安全用セーブを作成します。"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Relay cria um ponto guardado de segurança antes de usares códigos de batota pela primeira vez em cada sessão de jogo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每次遊戲首次使用作弊碼前，Relay 都會建立備份存檔。"
          }
        }
      }
    },
