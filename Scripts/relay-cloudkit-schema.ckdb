# Relay CloudKit schema v3 (CloudKit Schema Language), private database. v3 adds RelayArtwork (cover art).
# Source of truth for field names/types: Packages/RelayCloudKit/Sources/RelayCloudKit/RecordCodec.swift
# (RecordCodecTests.testSchemaFileListsEveryFieldTheCodecWrites keeps them aligned).
#
# Development import (owner):
#   xcrun cktool import-schema --team-id 56HPKRMH49 --container-id iCloud.app.relayemu.relay \
#       --environment development --file Scripts/relay-cloudkit-schema.ckdb
#
# Zones (created by the app, not by the schema): RelaySync (CKSyncEngine), RelayContent (on demand).
# Timestamps are INT64 milliseconds since 1970 UTC. Booleans are INT64 0/1.

DEFINE SCHEMA

    RECORD TYPE RelayGame (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        schema          INT64,
        generation      INT64,
        fingerprint     STRING,
        systemID        STRING,
        title           STRING,
        isFavorite      INT64,
        addedAt         INT64,
        updatedAt       INT64,
        contentSize     INT64,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_creator"
    );

    RECORD TYPE RelaySession (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        schema          INT64,
        generation      INT64,
        sessionID       STRING,
        fingerprint     STRING,
        installationID  STRING,
        deviceKind      STRING,
        coreID          STRING,
        startedAt       INT64,
        endedAt         INT64,
        pausedMs        INT64,
        screenshot      ASSET,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_creator"
    );

    RECORD TYPE RelayBatteryRevision (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        schema          INT64,
        generation      INT64,
        revisionID      STRING,
        fingerprint     STRING,
        parentIDs       LIST<STRING>,
        createdAt       INT64,
        dataFingerprint STRING,
        dataSize        INT64,
        installationID  STRING,
        deviceKind      STRING,
        data            ASSET,
        screenshot      ASSET,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_creator"
    );

    RECORD TYPE RelayState (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        schema                    INT64,
        generation      INT64,
        stateID                   STRING,
        fingerprint               STRING,
        kind                      STRING,
        coreID                    STRING,
        coreVersion               STRING,
        stateCompatibilityVersion STRING,
        formatVersion             INT64,
        createdAt                 INT64,
        payloadFingerprint        STRING,
        payloadSize               INT64,
        batteryRevisionID         STRING,
        installationID            STRING,
        deviceKind                STRING,
        label                     STRING,
        payload                   ASSET,
        screenshot                ASSET,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_creator"
    );

    RECORD TYPE RelayTombstone (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        schema          INT64,
        generation      INT64,
        gameFingerprint STRING,
        targetKind      STRING,
        targetKey       STRING,
        deletedAt       INT64,
        installationID  STRING,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_creator"
    );

    RECORD TYPE RelayContentIndex (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        schema          INT64,
        generation      INT64,
        fingerprint     STRING,
        size            INT64,
        fileName        STRING,
        systemID        STRING,
        partCount       INT64,
        uploadedAt      INT64,
        installationID  STRING,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_creator"
    );

    RECORD TYPE RelayGameContent (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        schema          INT64,
        generation      INT64,
        fingerprint     STRING,
        partIndex       INT64,
        partCount       INT64,
        partFingerprint STRING,
        partSize        INT64,
        data            ASSET,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_creator"
    );

    RECORD TYPE RelayArtwork (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        schema             INT64,
        generation         INT64,
        fingerprint        STRING,
        artworkFingerprint STRING,
        artworkSize        INT64,
        updatedAt          INT64,
        installationID     STRING,
        data               ASSET,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_creator"
    );
