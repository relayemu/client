    "NSLocalNetworkUsageDescription": {
      "extractionState": "manual",
      "comment": "System permission prompt shown when Relay Transfer probes nearby network addresses.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay connects to your computer to receive the games you choose."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay se connecte à ton ordinateur pour recevoir les jeux que tu choisis."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay verbindet sich mit deinem Computer, um die von dir ausgewählten Spiele zu empfangen."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay se conecta a tu ordenador para recibir los juegos que elijas."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay se conecta a tu computadora para recibir los juegos que elijas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay si collega al computer per ricevere i giochi che scegli."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay maakt verbinding met je computer om de games te ontvangen die je kiest."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay łączy się z twoim komputerem, aby odebrać wybrane przez ciebie gry."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Relay liga-se ao teu computador para receber os jogos que escolheres."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Relay se conecta ao seu computador para receber os jogos que você escolher."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay ansluter till din dator för att ta emot de spel du väljer."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay se conectează la computerul tău pentru a primi jocurile pe care le alegi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Relayはコンピュータに接続して、選択したゲームを受信します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay가 컴퓨터에 연결하여 선택한 게임을 받아요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay 會連接你的電腦，接收你選擇的遊戲。"
          }
        }
      }
    }
  },
  "version": "1.0"
